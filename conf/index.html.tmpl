<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@TITOLO@</title>
  <!-- I <link> delle icone li mette install.sh, uno per ogni file che trova
       davvero nel WEBROOT (o in conf/icone/, da cui li copia): i .png non
       stanno nel repo, e un <link> verso un file assente e' un 404 a ogni
       caricamento. Senza icone qui non compare niente. [RR] -->
@ICONE@
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    html, body { height: 100%; margin: 0; background-color: #121212; color: #fff; overflow: hidden; }
    /* la barra dei tab puo' andare a capo su schermi stretti: l'altezza dei pannelli
       si adatta da sola grazie al flex, senza calcoli fissi tipo calc(100vh - 56px) */
    body { display: flex; flex-direction: column; }
    /* un solo accento per tutto cio' che e' "acceso": tab attivo e etichetta in modifica [RR] */
    :root { --acc: #35e3a4; --acc-fondo: #10261f; --acc-bordo: #1f5544; }
    .nav-tabs { background-color: #1e1e1e; border-bottom: 1px solid #333; flex: 0 0 auto; }
    .nav-link {
      position: relative;   /* ancora la barra dell'accento [RR] */
      color: #8c8c8c; border-radius: 0;
      cursor: grab; user-select: none;
      touch-action: none;   /* serve ai pointer events: senza, il touch scrolla invece di trascinare */
      transition: color .18s cubic-bezier(.32,.72,0,1), background-color .18s cubic-bezier(.32,.72,0,1);
    }
    /* Il bordo dell'hover di Bootstrap e' quasi bianco (#e9ecef): sul tab appena
       lasciato, che sta ancora sotto il puntatore, sembrava un secondo tab
       selezionato. Serve la stessa specificita' di Bootstrap (.nav-tabs .nav-link). [RR] */
    .nav-tabs .nav-link:hover, .nav-tabs .nav-link:focus {
      border-color: #3a3a3a #3a3a3a transparent;
    }
    .nav-link:hover:not(.active) { color: #e6e6e6; background-color: #262626; }
    /* Il fuoco del browser NON deve marcare i tab: dopo una rinomina restava
       l'alone azzurro sul tab di prima, che sembrava cosi' quello selezionato
       anche dopo Shift+frecce. Lo stato attivo lo dice gia' il colore. [RR] */
    .nav-link:focus, .nav-link:focus-visible { outline: none; box-shadow: none; }
    .nav-link.active {
      background-color: var(--acc-fondo) !important;
      color: var(--acc) !important;
      font-weight: 600; letter-spacing: .01em;
      border-color: var(--acc-bordo) var(--acc-bordo) var(--acc-fondo) !important;
    }
    /* barra accesa sopra il tab attivo: si trova a colpo d'occhio anche con 10 tab [RR] */
    .nav-link.active::after {
      content: ''; position: absolute; left: -1px; right: -1px; top: -1px; height: 3px;
      background: var(--acc); box-shadow: 0 0 10px rgba(53,227,164,.55);
    }
    .nav-link.trascina { opacity: .45; cursor: grabbing; }
    .tab-content { flex: 1 1 auto; min-height: 0; }
    .tab-pane { height: 100%; position: relative; }   /* riferimento per l'overlay di congelamento */
    iframe { width: 100%; height: 100%; border: none; display: block; background: #000; }
    .barra-dx { margin-left: auto; display: flex; align-items: center; gap: .6rem; padding: 0 .6rem; }
    .bottone-gela {
      background: #2a2a2a; color: #ccc; border: 1px solid #444; border-radius: 3px;
      font-size: .78rem; padding: .15rem .5rem; cursor: pointer; white-space: nowrap;
    }
    .bottone-gela:hover { background: #333; color: #fff; }
    /* 'A-' e 'A+' dicevano quanto un segno di spunta: il verso adesso lo
       disegna la dimensione stessa delle due lettere, A>a rimpicciolisce e
       a>A ingrandisce. Niente da tradurre e niente da ricordare. [RR] */
    .lettera-g { font-size: 1.1em; }
    .lettera-p { font-size: .72em; }
    .verso { color: #777; font-size: .8em; margin: 0 .1em; }
    /* etichetta in modifica: si vede che e' un campo, non un'etichetta.
       user-select va riattivato, il .nav-link lo spegne per il trascinamento. */
    .etichetta[contenteditable="true"] {
      outline: none; background: #000; color: #fff;
      box-shadow: 0 0 0 1px var(--acc); border-radius: 2px; padding: 0 .2em;
      min-width: 2em; display: inline-block;
      cursor: text; user-select: text;
    }
    /* --- overlay di congelamento --- */
    .gelo { position: absolute; inset: 0; z-index: 10; display: flex; flex-direction: column; background: #0b0b0b; }
    .gelo-barra {
      flex: 0 0 auto; display: flex; align-items: center; gap: .8rem; flex-wrap: wrap;
      padding: .35rem .6rem; background: #16324a; border-bottom: 1px solid #27506f;
      font-size: .8rem; color: #cde;
    }
    .gelo-barra button {
      background: #1e1e1e; color: #ddd; border: 1px solid #456; border-radius: 3px;
      font-size: .78rem; padding: .15rem .55rem; cursor: pointer;
    }
    .gelo-barra button:hover { background: #2a2a2a; color: #fff; }
    .gelo-barra label { display: flex; align-items: center; gap: .3rem; cursor: pointer; user-select: none; }
    .gelo-nota { color: #8ab; font-size: .75rem; }
    .gelo-testo {
      flex: 1 1 auto; overflow: auto; margin: 0; padding: .5rem .7rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
      font-size: 13px; line-height: 1.25; white-space: pre; color: #ddd;
      user-select: text; -webkit-user-select: text;
    }
    /* --- barra dei tasti che un telefono non ha --- */
    /* Tab, Esc, frecce e PagSu/PagGiu non stanno sulla tastiera di sistema di
       un telefono: senza, in tmux o in vi non ci si muove e non si completa
       un nome di file. Sul desktop la barra e' solo ingombro, percio' di
       serie compare dove il puntatore e' grosso (un dito) e altrove la si
       accende col bottone. L'altezza dei pannelli si adatta da se': e' il
       motivo per cui il layout e' in flex e non a calc(). [RR] */
    .tastiera { display: none; }
    body.mostra-tastiera .tastiera {
      flex: 0 0 auto; display: flex; flex-wrap: wrap; gap: .3rem;
      padding: .35rem .4rem; background: #1a1a1a; border-top: 1px solid #333;
    }
    /* Congelato, l'input e' bloccato: i tasti si spengono invece di sparire,
       cosi' non sembra che si sia rotto qualcosa. */
    body.gelo-attivo .tastiera { opacity: .3; pointer-events: none; }
    .tasto {
      flex: 1 1 auto; min-width: 2.7rem; min-height: 2.5rem;
      background: #2b2b2b; color: #ddd; border: 1px solid #444; border-radius: 4px;
      font-family: inherit; font-size: .95rem; line-height: 1;
      cursor: pointer; user-select: none; -webkit-user-select: none;
      touch-action: manipulation;   /* niente zoom sul doppio tap ravvicinato */
    }
    .tasto:active { background: var(--acc-fondo); color: var(--acc); border-color: var(--acc-bordo); }
    .tasto:focus, .tasto:focus-visible { outline: none; }

    /* Un bottone della testata che rappresenta uno stato ACCESO, non un
       comando: stesso accento del tab attivo, cosi' "acceso" vuol dire la
       stessa cosa in tutta la pagina. */
    .bottone-gela.acceso {
      background: var(--acc-fondo); color: var(--acc); border-color: var(--acc-bordo);
      font-weight: 600;
    }

    /* Spia della modalita' storia (copy-mode di tmux). Nel footer perche' e'
       dove stanno le frecce che in quella modalita' scorrono la storia, ed e'
       dove guardi mentre le premi. Fuori dalla modalita' non c'e'. */
    .spia {
      display: none; align-items: center; gap: .3rem;
      padding: 0 .55rem; border-radius: 4px; white-space: nowrap;
      font-size: .78rem; font-weight: 600;
      color: var(--acc); background: var(--acc-fondo); border: 1px solid var(--acc-bordo);
    }
    body.storia .spia { display: flex; }
    /* e la barra intera si accende: si vede con la coda dell'occhio, senza
       dover leggere l'etichetta */
    body.storia.mostra-tastiera .tastiera {
      border-top: 1px solid var(--acc); background: #14231e;
    }

    /* --- finestra dell'aiuto ------------------------------------------------
       Le scorciatoie stavano scritte in un rigo di testata largo mezzo schermo,
       che spariva sotto i 1100px -- cioe' proprio dove non c'e' posto per
       ricordarsele. Adesso stanno qui, e la testata torna ai soli bottoni. */
    .aiuto {
      position: fixed; inset: 0; z-index: 50; padding: 1rem;
      display: flex; align-items: center; justify-content: center;
      background: rgba(0,0,0,.62);
    }
    .aiuto-carta {
      background: #1a1a1a; border: 1px solid #3a3a3a; border-radius: 6px;
      width: 100%; max-width: 44rem; max-height: 86vh; overflow: auto;
      box-shadow: 0 12px 44px rgba(0,0,0,.6);
    }
    /* la testata resta in vista mentre si scorre: la via d'uscita non deve
       finire fuori schermo */
    .aiuto-testata {
      position: sticky; top: 0; z-index: 1;
      display: flex; align-items: center; gap: .6rem;
      padding: .55rem .9rem; background: #1a1a1a; border-bottom: 1px solid #333;
    }
    .aiuto-testata strong { color: var(--acc); font-size: .95rem; flex: 1 1 auto; }
    .aiuto-corpo { padding: .2rem .9rem 1rem; }
    .aiuto h3 {
      margin: 1rem 0 .4rem; font-size: .72rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: .09em; color: #7d7d7d;
    }
    .aiuto dl { display: grid; grid-template-columns: max-content 1fr; gap: .35rem .9rem; margin: 0; }
    .aiuto dt { white-space: nowrap; }
    .aiuto dd { margin: 0; align-self: center; color: #b8b8b8; font-size: .84rem; }
    .aiuto kbd {
      background: #000; color: #e8e8e8; border: 1px solid #454545; border-bottom-width: 2px;
      border-radius: 3px; padding: .05rem .35rem; font-size: .78rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
    }
    .aiuto .gesto { color: #9a9a9a; font-size: .8rem; font-style: italic; }
    .aiuto .sep { color: #666; margin: 0 .2em; }
    .aiuto p { margin: .8rem 0 0; color: #8f8f8f; font-size: .8rem; }
    /* Su un telefono due colonne non ci stanno: il tasto va sopra la
       descrizione. La misura la decide la classe che il JS mette sul body,
       non una media query di qui. */
    body.schermo-piccolo .aiuto dl { grid-template-columns: 1fr; gap: .1rem; }
    body.schermo-piccolo .aiuto dd { margin-bottom: .45rem; }

    /* --- griglia: piu' terminali insieme ------------------------------------
       Le celle NON spostano i pannelli nel DOM: si accendono con display e si
       mettono in fila con la proprieta' order. Spostare un <iframe> lo
       ricarica -- websocket chiusa, scrollback perso -- ed e' il motivo per
       cui qui si tocca solo il CSS e mai la struttura. [RR]
       Le soglie di quando la griglia ci sta stanno nel JS (GRIGLIE), come per
       SCHERMI: qui si reagisce alle classi che mette sul body. */
    body.griglia .tab-content {
      display: grid; gap: 2px;
      background: #333;            /* si vede solo nelle fughe fra le celle */
    }
    body.griglia-2 .tab-content { grid-template-columns: 1fr 1fr; }
    body.griglia-4 .tab-content { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
    body.griglia-6 .tab-content { grid-template-columns: 1fr 1fr 1fr; grid-template-rows: 1fr 1fr; }

    /* Bootstrap tiene nascosti i pannelli non attivi e a opacita' 0 quelli
       .fade: in griglia ne servono N a schermo, non uno. Il selettore passa
       per l'id per battere .tab-content > .tab-pane senza !important. */
    body.griglia #terminalTabsContent > .tab-pane.in-griglia {
      display: block; opacity: 1; height: 100%; min-width: 0; min-height: 0;
    }

    /* Quale cella riceve i tasti. E' un ::after e non un bordo perche' il
       bordo stringerebbe la cella, e quindi il terminale: il pty verrebbe
       ridimensionato a ogni spostamento solo per accendere una cornice.
       z-index sotto .gelo (10), che deve restare sopra. */
    body.griglia .tab-pane.in-griglia.active::after {
      content: ''; position: absolute; inset: 0; z-index: 5; pointer-events: none;
      border: 2px solid var(--acc); box-shadow: inset 0 0 12px rgba(53,227,164,.14);
    }

    /* --- adattamento allo schermo --- */
    /* I limiti stanno SOLO nel JS (vedi SCHERMI): qui si reagisce alle classi
       che mette sul body. Con una media query qui e un matchMedia la', prima
       o poi i due numeri divergono e nessuno se ne accorge. [RR] */

    /* Su un telefono i tab di Bootstrap -- 1rem di testo, .5rem/1rem di
       padding -- diventano dieci mattoni che si mangiano tre righe di
       schermo: in verticale sono ~150px su 700, tolti al terminale.
       Si stringono soprattutto in LARGHEZZA: e' quella che decide quanti
       tab stanno per riga, e quindi quante righe. L'altezza si abbassa poco,
       perche' sotto i ~25px un tab non lo si prende piu' col dito. */
    body.schermo-medio   .nav-link { padding: .35rem .6rem;  font-size: .85rem; }
    body.schermo-piccolo .nav-link { padding: .35rem .45rem; font-size: .8rem; }

    /* Le etichette lunghe si troncano invece di allargare il tab: un nome da
       venti caratteri, con dieci tab, riporta il problema da capo. */
    body.schermo-medio   .etichetta,
    body.schermo-piccolo .etichetta {
      display: inline-block; max-width: 7ch; vertical-align: bottom;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    /* Mentre si rinomina no: troncato non si vedrebbe quello che si scrive. */
    body.schermo-medio   .etichetta[contenteditable="true"],
    body.schermo-piccolo .etichetta[contenteditable="true"] {
      max-width: none; overflow: visible;
    }

    /* I bottoni della testata restano sulla barra dei tab: la barra e'
       flex: 0 0 auto in cima al body, quindi qualunque altezza prenda e'
       sempre a schermo e il bottone non finisce mai sotto la piega. */
    body.schermo-medio   .bottone-gela,
    body.schermo-piccolo .bottone-gela { font-size: .72rem; padding: .1rem .4rem; }
    body.schermo-medio   .barra-dx,
    body.schermo-piccolo .barra-dx { gap: .35rem; padding: 0 .35rem; }
    body.schermo-piccolo .tasto { min-width: 2.4rem; font-size: .9rem; }
  </style>
</head>
<body>

  <!-- Barra dei TAB -->
  <ul class="nav nav-tabs" id="terminalTabs" role="tablist"></ul>

  <!-- Contenuto iFrame per ogni terminale -->
  <div class="tab-content" id="terminalTabsContent"></div>

  <!-- Tasti speciali per chi arriva da un telefono: riempita da JS -->
  <div class="tastiera" id="tastiera"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Un elemento per ogni istanza ttyd in ascolto sulla loopback, esposta da
    // nginx come /term<id>/ (l'elenco lo scrive install.sh da N_TERM).
    // Gli URL sono RELATIVI: stesso host, stesso https, stesso mTLS della dashboard.
@TERMINALS@

    var CHIAVE_NOMI   = 'terminal-dashboard-nomi';
    var CHIAVE_ORDINE = 'terminal-dashboard-ordine';
    // Quando questo browser ha cambiato qualcosa l'ultima volta. Serve a
    // decidere chi ha ragione fra la cache e il server: senza, il profilo che
    // arriva dalla rete cancella quello che si e' appena fatto qui. [RR]
    var CHIAVE_AGG    = 'terminal-dashboard-agg';
    // Quale nome automatico si vuole: 'T' il titolo che scrive l'applicazione,
    // 'W' il comando in esecuzione, 'no' nessuno (valgono solo i nomi miei).
    var CHIAVE_TITOLI = 'terminal-dashboard-titoli';

    var tabs = document.getElementById('terminalTabs');
    var panes = document.getElementById('terminalTabsContent');
    var inModifica = false;   // mentre si rinomina, la tastiera non naviga
    var gelo = null;          // pannello attualmente congelato

    // --- preferenze locali ---------------------------------------------------
    // Nomi e ordine stanno in localStorage: valgono per questo browser, non per
    // il server. Ogni accesso e' protetto, lo storage puo' essere negato.
    function leggi(chiave, vuoto) {
      try { return JSON.parse(localStorage.getItem(chiave)) || vuoto; }
      catch (err) { return vuoto; }
    }
    function scrivi(chiave, valore) {
      try { localStorage.setItem(chiave, JSON.stringify(valore)); }
      catch (err) { /* storage non disponibile: le preferenze valgono per questa sessione */ }
    }

    // nome di default per id, indipendente dall'ordine dei tab
    var PREDEFINITI = {};
    TERMINALS.forEach(function (t) { PREDEFINITI[t.id] = t.label; });

    // --- nomi automatici -----------------------------------------------------
    // Quello che il terminale racconta di se': per ogni id il titolo scritto
    // dall'applicazione (T) e il comando in esecuzione (W). Li manda tmux --
    // vedi conf/tmux-terminali.conf -- dentro il titolo del documento
    // dell'iframe, i due campi insieme, e la scelta di quale mostrare si fa
    // qui: cambiarla non tocca tmux e non riavvia niente. [RR]
    var AUTO = {};
    var SEP = '\u241F';
    var TITOLO_RE = new RegExp('DH' + SEP + '([^' + SEP + ']*)' + SEP + '([^' + SEP + ']*)' + SEP);
    var MODI_TITOLO = ['T', 'W', 'no'];
    var ETICHETTE_MODO = { T: '🏷 Titolo', W: '🏷 Comando', no: '🏷 Nomi miei' };
    var SPIEGA_MODO = {
      T: 'I tab prendono il titolo che scrive l\'applicazione (vim, ssh, top). Clicca per il comando in esecuzione.',
      W: 'I tab prendono il comando in esecuzione. Clicca per usare solo i nomi scritti da te.',
      no: 'I tab tengono i nomi scritti da te. Clicca per tornare al titolo dell\'applicazione.'
    };
    var modoTitolo = leggi(CHIAVE_TITOLI, 'T');
    if (MODI_TITOLO.indexOf(modoTitolo) < 0) modoTitolo = 'T';

    // Da chiamare a ogni modifica VOLUTA (un nome, l'ordine, la griglia):
    // e' la data che il caricamento dopo confronta con quella del server.
    function tocca() { scrivi(CHIAVE_AGG, Date.now()); }

    function salvaNome(id, nome) {
      var n = leggi(CHIAVE_NOMI, {});
      if (nome) n[id] = nome; else delete n[id];
      scrivi(CHIAVE_NOMI, n);
      tocca();
    }
    function salvaOrdine() {
      scrivi(CHIAVE_ORDINE, pulsanti().map(function (b) { return Number(b.dataset.id); }));
      tocca();
    }

    // --- che nome porta un tab -----------------------------------------------
    // Un posto solo a decidere, perche' i nomi arrivano da tre parti: il
    // terminale (automatico), la rinomina a mano (localStorage e profilo) e
    // l'elenco di serie. PRECEDE L'AUTOMATICO: se il terminale dice come si
    // chiama, quello si legge. Il nome scritto a mano non si perde -- resta
    // salvato e torna a vedersi appena l'automatico non ha niente da dire, o
    // spegnendolo dal bottone. [RR]
    function nomeMio(id) {
      var n = leggi(CHIAVE_NOMI, {});
      return n[id] || PREDEFINITI[id];
    }
    function nomeAuto(id) {
      if (modoTitolo === 'no') return '';
      var a = AUTO[id];
      if (!a) return '';
      return (modoTitolo === 'W' ? a.W : a.T) || '';
    }
    function scriviEtichetta(id) {
      var btn = document.getElementById('term' + id + '-tab');
      var span = btn && btn.querySelector('.etichetta');
      if (!span || span.isContentEditable) return;   // rinomina in corso: non si tocca
      var testo = nomeAuto(id) || nomeMio(id);
      if (span.textContent !== testo) span.textContent = testo;
    }
    function scriviEtichette() {
      TERMINALS.forEach(function (t) { scriviEtichetta(t.id); });
    }

    function mostraModoTitolo() {
      bottoneTitoli.textContent = ETICHETTE_MODO[modoTitolo];
      bottoneTitoli.title = SPIEGA_MODO[modoTitolo];
    }
    function commutaModoTitolo() {
      modoTitolo = MODI_TITOLO[(MODI_TITOLO.indexOf(modoTitolo) + 1) % MODI_TITOLO.length];
      scrivi(CHIAVE_TITOLI, modoTitolo);   // senza tocca(): e' di questo browser, non del profilo
      mostraModoTitolo();
      scriviEtichette();
    }
    // Il titolo del documento dentro l'iframe porta i due campi insieme,
    // "DH<US>titolo<US>comando<US>", piu' la coda che ttyd ci appende
    // (" | " e il titolo suo). Quello che non corrisponde -- il titolo di
    // ttyd prima che tmux si faccia vivo, o una pagina d'errore -- non e' un
    // nome e si ignora, lasciando il tab a quello che aveva.
    function registraTitolo(id, titolo) {
      var m = TITOLO_RE.exec(titolo || '');
      if (!m) return;
      var a = AUTO[id] || (AUTO[id] = { T: '', W: '' });
      var t = m[1].trim(), w = m[2].trim();
      if (a.T === t && a.W === w) return;
      a.T = t; a.W = w;
      scriviEtichetta(id);
    }

    // ttyd scrive document.title a ogni cambio di titolo del terminale
    // (xterm.js -> onTitleChange). Same-origin, quindi lo si guarda da qui:
    // il <title> puo' non esistere ancora quando l'iframe carica, percio'
    // l'osservatore sta sulla testa e non sul nodo del titolo.
    function agganciaTitolo(f, id) {
      var d;
      try { d = f.contentDocument; } catch (err) { return; }
      if (!d || d.__titoloAgganciato) return;
      d.__titoloAgganciato = true;
      var testa = d.head || d.documentElement;
      if (!testa) return;
      function guarda() { registraTitolo(id, d.title); }
      guarda();
      new MutationObserver(guarda).observe(testa, { childList: true, subtree: true, characterData: true });
    }

    // --- costruzione ---------------------------------------------------------
    var nomi = leggi(CHIAVE_NOMI, {});
    var ordine = leggi(CHIAVE_ORDINE, []);
    if (!Array.isArray(ordine)) ordine = [];

    // I terminali sconosciuti all'ordine salvato (es. dopo averne aggiunto uno
    // a TERMINALS) finiscono in coda, per id.
    var elenco = TERMINALS.slice().sort(function (a, b) {
      var ia = ordine.indexOf(a.id); if (ia < 0) ia = Infinity;
      var ib = ordine.indexOf(b.id); if (ib < 0) ib = Infinity;
      return ia === ib ? a.id - b.id : ia - ib;
    });

    elenco.forEach(function (t, i) {
      var li = document.createElement('li');
      li.className = 'nav-item';
      li.setAttribute('role', 'presentation');

      var btn = document.createElement('button');
      btn.className = 'nav-link' + (i === 0 ? ' active' : '');
      btn.id = 'term' + t.id + '-tab';
      btn.type = 'button';
      btn.setAttribute('role', 'tab');
      btn.setAttribute('data-bs-toggle', 'tab');
      btn.setAttribute('data-bs-target', '#term' + t.id);
      btn.title = 'Doppio click per rinominare, trascina per spostare';
      btn.dataset.id = t.id;

      var span = document.createElement('span');
      span.className = 'etichetta';
      span.textContent = nomi[t.id] || t.label;
      btn.appendChild(span);

      li.appendChild(btn);
      tabs.appendChild(li);

      var pane = document.createElement('div');
      pane.className = 'tab-pane fade' + (i === 0 ? ' show active' : '');
      pane.id = 'term' + t.id;
      pane.setAttribute('role', 'tabpanel');
      pane.dataset.src = '/term' + t.id + '/';
      panes.appendChild(pane);
    });

    var barraDx = document.createElement('li');
    barraDx.className = 'barra-dx';
    var bottoneTastiera = document.createElement('button');
    bottoneTastiera.type = 'button';
    bottoneTastiera.className = 'bottone-gela';
    // Non il solo glifo: '⌨' da solo, in mezzo a dieci tab, non si capisce
    // che sia un interruttore ne' di cosa.
    bottoneTastiera.textContent = '⌨ Tasti';

    // Modalita' storia = copy-mode di tmux, quella di Ctrl-B [. Il bottone sta
    // in TESTATA e non nel footer, cosi' c'e' anche sul desktop dove la barra
    // dei tasti di serie non compare; e si accende, perche' e' un interruttore
    // di stato e non un comando. [RR]
    var bottoneStoria = document.createElement('button');
    bottoneStoria.type = 'button';
    bottoneStoria.className = 'bottone-gela';
    bottoneStoria.textContent = '⇱ Storia';

    // Dimensione dei caratteri del terminale, a mano. Sta accanto agli altri
    // per lo stesso motivo: serve dove lo schermo e' piccolo, ma va raggiunta
    // anche da un portatile.
    // Il verso lo dicono le lettere: A>a rimpicciolisce, a>A ingrandisce.
    // Il nome per chi non vede il bottone lo mette etichetteFont, insieme al
    // titolo, perche' li' c'e' anche la misura di adesso.
    function lettere(giu) {
      var f = document.createDocumentFragment();
      [[giu ? 'A' : 'a', giu ? 'lettera-g' : 'lettera-p'],
       ['›', 'verso'],
       [giu ? 'a' : 'A', giu ? 'lettera-p' : 'lettera-g']].forEach(function (x) {
        var s = document.createElement('span');
        s.className = x[1];
        s.textContent = x[0];
        f.appendChild(s);
      });
      return f;
    }

    var bottoneGiu = document.createElement('button');
    bottoneGiu.type = 'button';
    bottoneGiu.className = 'bottone-gela';
    bottoneGiu.appendChild(lettere(true));
    var bottoneSu = document.createElement('button');
    bottoneSu.type = 'button';
    bottoneSu.className = 'bottone-gela';
    bottoneSu.appendChild(lettere(false));
    // Piu' terminali insieme, dove c'e' spazio. Un bottone solo che cicla
    // 1 -> 2 -> 4 -> 6 fra i formati che lo schermo regge: tre bottoni in piu'
    // su una barra che ne ha gia' cinque si notano piu' della funzione che
    // offrono. Dove non ci sta nemmeno la griglia da 2 non compare affatto,
    // com'e' per la barra dei tasti sul desktop.
    var bottoneGriglia = document.createElement('button');
    bottoneGriglia.type = 'button';
    bottoneGriglia.className = 'bottone-gela';
    bottoneGriglia.textContent = '⊞ Griglia';

    var bottoneGela = document.createElement('button');
    bottoneGela.type = 'button';
    bottoneGela.className = 'bottone-gela';
    bottoneGela.textContent = '❄ Congela';
    bottoneGela.title = 'Blocca l\'input e mostra il testo selezionabile (Ctrl+Alt+C)';
    // Le scorciatoie stavano in un rigo di testo qui in testata: lungo, e
    // nascosto proprio sugli schermi stretti dove servirebbe. Ora stanno nella
    // finestra dell'aiuto, che si apre da questo bottone o con Ctrl+H.
    // Il nome automatico si sceglie da qui, e si sceglie ADESSO: tmux manda
    // sempre tutti e due i campi, quindi passare dal titolo dell'applicazione
    // al comando -- o spegnere l'automatico -- e' solo una decisione di questa
    // pagina. Niente da riconfigurare sul server, niente da riavviare. [RR]
    var bottoneTitoli = document.createElement('button');
    bottoneTitoli.type = 'button';
    bottoneTitoli.className = 'bottone-gela';
    // Qui e non lassu' con commutaModoTitolo(): il bottone nasce a questo
    // punto del file, e agganciarsi prima vuol dire agganciarsi a undefined.
    bottoneTitoli.addEventListener('click', commutaModoTitolo);

    var bottoneAiuto = document.createElement('button');
    bottoneAiuto.type = 'button';
    bottoneAiuto.className = 'bottone-gela';
    bottoneAiuto.textContent = '? Aiuto';

    barraDx.appendChild(bottoneGiu);
    barraDx.appendChild(bottoneSu);
    barraDx.appendChild(bottoneTitoli);
    barraDx.appendChild(bottoneGriglia);
    barraDx.appendChild(bottoneTastiera);
    barraDx.appendChild(bottoneStoria);
    barraDx.appendChild(bottoneGela);
    barraDx.appendChild(bottoneAiuto);
    tabs.appendChild(barraDx);

    // --- navigazione ---------------------------------------------------------
    // L'ordine dei tab e' modificabile, quindi la posizione va letta dal DOM
    // ogni volta: non si puo' tenere un indice memorizzato.
    function pulsanti() {
      return Array.prototype.slice.call(tabs.querySelectorAll('.nav-link'));
    }
    function indiceAttivo() {
      var b = pulsanti();
      for (var i = 0; i < b.length; i++) if (b[i].classList.contains('active')) return i;
      return 0;
    }
    function pannelloAttivo() { return panes.querySelector('.tab-pane.active'); }
    function vaiA(i) {
      var b = pulsanti(), n = b.length;
      if (!n) return;
      i = ((i % n) + n) % n;                  // ciclico: dall'ultimo si torna al primo
      bootstrap.Tab.getOrCreateInstance(b[i]).show();
    }
    function vaiPerId(id) {
      var btn = document.getElementById('term' + id + '-tab');
      if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
    }

    tabs.addEventListener('shown.bs.tab', function (e) {
      if (gelo) scongela();                   // cambiare tab rilascia il congelamento
      // Bootstrap sposta il fuoco solo quando il tab si cambia con la SUA tastiera:
      // chiamando show() da codice (Shift+frecce, Alt+cifra) il fuoco resta dov'era,
      // cioe' sul tab precedente. Va tolto a mano, o resta li' evidenziato. [RR]
      var conFuoco = document.activeElement;
      if (conFuoco && conFuoco.classList && conFuoco.classList.contains('nav-link')) conFuoco.blur();
      var pane = document.querySelector(e.target.getAttribute('data-bs-target'));
      // In griglia il tab non cambia la vista intera: se quel terminale non e'
      // gia' a schermo prende il posto della cella che stiamo lasciando.
      if (idsGriglia.length > 1) sostituisciCella(pane, e.relatedTarget);
      caricaPannello(pane);
      if (!inModifica) dagliIlFuoco(pane);
    });

    // --- accesso a xterm.js --------------------------------------------------
    // ttyd fa `window.term = terminal` dentro la propria pagina. Essendo
    // same-origin possiamo prenderlo dal genitore: da' il buffer del terminale
    // e l'opzione disableStdin, che e' tutto quello che serve qui.
    function termDi(pane) {
      var f = pane && pane.querySelector('iframe');
      try { return (f && f.contentWindow && f.contentWindow.term) || null; }
      catch (err) { return null; }
    }

    // Testo della schermata visibile, riga per riga come appare a video.
    // Con `ricongiungi` le righe spezzate dal wrap tornano una riga sola:
    // in quel caso non si tagliano gli spazi a destra, o si perderebbero
    // caratteri nel punto di giunzione.
    function schermata(term, ricongiungi) {
      var buf = term.buffer.active, out = [];
      for (var i = 0; i < term.rows; i++) {
        var y = buf.viewportY + i;
        var linea = buf.getLine(y);
        if (!linea) continue;
        var succ = (i + 1 < term.rows) ? buf.getLine(y + 1) : null;
        var continua = !!(ricongiungi && succ && succ.isWrapped);
        var testo = linea.translateToString(!continua);
        if (ricongiungi && linea.isWrapped && out.length) out[out.length - 1] += testo;
        else out.push(testo);
      }
      while (out.length && out[out.length - 1] === '') out.pop();
      return out.join('\n');
    }

    // --- copia ---------------------------------------------------------------
    // navigator.clipboard e' affidabile perche' la pagina e' su https e la
    // chiamata parte da un click o da un tasto, quindi il gesto utente c'e'.
    // Il ripiego su execCommand serve solo ai browser che non lo espongono.
    function copiaTesto(testo, avviso) {
      function ok() { if (avviso) avviso(true); }
      function no() { if (avviso) avviso(false); }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(testo).then(ok, ripiego);
      } else {
        ripiego();
      }
      function ripiego() {
        var ta = document.createElement('textarea');
        ta.value = testo;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var esito = false;
        try { esito = document.execCommand('copy'); } catch (err) { esito = false; }
        document.body.removeChild(ta);
        esito ? ok() : no();
      }
    }

    // --- congelamento --------------------------------------------------------
    // L'input viene bloccato con disableStdin, poi il testo della schermata
    // viene mostrato in un <pre>: essendo testo HTML normale, selezione e
    // copia funzionano sempre, senza dipendere dalla selezione interna di
    // xterm.js ne' dall'auto-copia di ttyd.
    // Il congelamento NON seleziona niente: serve a fermare l'output e a
    // rendere il testo selezionabile col mouse, la scelta di cosa copiare e'
    // di chi guarda. Una selezione automatica di tutta la schermata va
    // disfatta prima di poter prendere le tre righe che interessano, e nel
    // frattempo un Ctrl+C distratto copia mille caratteri. [RR]
    function congela() {
      if (gelo || inModifica) return;
      var pane = pannelloAttivo();
      var term = termDi(pane);
      if (!term) {
        bottoneGela.textContent = '❄ terminale non pronto';
        setTimeout(function () { bottoneGela.textContent = '❄ Congela'; }, 1500);
        return;
      }

      var stdinPrima = term.options.disableStdin;
      term.options.disableStdin = true;
      try { term.blur(); } catch (err) {}

      var overlay = document.createElement('div');
      overlay.className = 'gelo';

      var barra = document.createElement('div');
      barra.className = 'gelo-barra';

      var titolo = document.createElement('strong');
      titolo.textContent = '❄ Congelato';

      var chk = document.createElement('input');
      chk.type = 'checkbox';
      chk.id = 'gelo-unwrap';
      var lab = document.createElement('label');
      lab.htmlFor = chk.id;
      lab.appendChild(chk);
      lab.appendChild(document.createTextNode('ricongiungi le righe spezzate'));

      var bCopia = document.createElement('button');
      bCopia.type = 'button';
      bCopia.textContent = 'Copia tutto';

      var bChiudi = document.createElement('button');
      bChiudi.type = 'button';
      bChiudi.textContent = 'Riprendi (Esc)';

      var nota = document.createElement('span');
      nota.className = 'gelo-nota';
      nota.textContent = 'input bloccato · seleziona col mouse e Ctrl+C';

      barra.appendChild(titolo);
      barra.appendChild(lab);
      barra.appendChild(bCopia);
      barra.appendChild(bChiudi);
      barra.appendChild(nota);

      var pre = document.createElement('pre');
      pre.className = 'gelo-testo';
      pre.textContent = schermata(term, false);

      overlay.appendChild(barra);
      overlay.appendChild(pre);
      pane.appendChild(overlay);

      gelo = { pane: pane, term: term, overlay: overlay, stdinPrima: stdinPrima };
      document.body.classList.add('gelo-attivo');   // spegne la barra dei tasti

      // Riscrivere il testo butta via la selezione in corso: e' inevitabile,
      // ma non se ne fa una nuova al posto di quella dell'utente.
      chk.addEventListener('change', function () {
        pre.textContent = schermata(term, chk.checked);
      });
      bCopia.addEventListener('click', function () {
        copiaTesto(pre.textContent, function (ok) {
          bCopia.textContent = ok ? 'Copiato ✓' : 'Non riesco';
          setTimeout(function () { bCopia.textContent = 'Copia tutto'; }, 1400);
        });
      });
      bChiudi.addEventListener('click', scongela);

      bottoneGela.textContent = '❄ Riprendi';
    }

    function scongela() {
      if (!gelo) return;
      var g = gelo;
      gelo = null;
      document.body.classList.remove('gelo-attivo');
      try { g.term.options.disableStdin = g.stdinPrima; } catch (err) {}
      if (g.overlay.parentNode) g.overlay.parentNode.removeChild(g.overlay);
      // Il <pre> non c'e' piu': la selezione che lo puntava va chiusa a mano,
      // o resta un range appeso a un nodo staccato dal documento.
      window.getSelection().removeAllRanges();
      bottoneGela.textContent = '❄ Congela';
      dagliIlFuoco(g.pane);
    }

    bottoneGela.addEventListener('click', function () { gelo ? scongela() : congela(); });

    // --- riordino ------------------------------------------------------------
    // Pointer events invece di HTML5 drag-and-drop, che sui browser touch non
    // funziona. Il trascinamento parte solo dopo una soglia di movimento, cosi'
    // un click resta un click e il doppio click resta una rinomina.
    var SOGLIA = 6;
    var preso = null, xPartenza = 0, yPartenza = 0, trascinando = false;

    tabs.addEventListener('pointerdown', function (e) {
      if (inModifica || e.button !== 0) return;
      var btn = e.target.closest('.nav-link');
      if (!btn) return;
      preso = btn;
      xPartenza = e.clientX;
      yPartenza = e.clientY;
      trascinando = false;
      // la cattura tiene i pointermove agganciati al pulsante anche se il
      // puntatore finisce sopra un iframe
      try { btn.setPointerCapture(e.pointerId); } catch (err) {}
    });

    tabs.addEventListener('pointermove', function (e) {
      if (!preso) return;
      if (!trascinando) {
        if (Math.abs(e.clientX - xPartenza) < SOGLIA && Math.abs(e.clientY - yPartenza) < SOGLIA) return;
        trascinando = true;
        preso.classList.add('trascina');
      }
      var li = preso.parentElement;
      var voci = Array.prototype.slice.call(tabs.querySelectorAll('.nav-item'));
      for (var i = 0; i < voci.length; i++) {
        if (voci[i] === li) continue;
        var r = voci[i].getBoundingClientRect();
        // test sul rettangolo intero, non solo su X: con 10 tab la barra puo'
        // andare a capo e ci sono piu' righe
        if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) continue;
        if (e.clientX < r.left + r.width / 2) tabs.insertBefore(li, voci[i]);
        else tabs.insertBefore(li, voci[i].nextSibling);
        break;
      }
    });

    function fineTrascinamento(e) {
      if (!preso) return;
      try { preso.releasePointerCapture(e.pointerId); } catch (err) {}
      preso.classList.remove('trascina');
      // Le celle stanno nell'ordine dei tab: se l'ordine e' cambiato, la
      // griglia va ridisposta (i pannelli non si toccano, cambia solo order).
      if (trascinando) {
        salvaOrdine();
        if (idsGriglia.length > 1) applicaGriglia(idsGriglia);
        sincronizza();
      }
      preso = null;
      trascinando = false;
    }
    tabs.addEventListener('pointerup', fineTrascinamento);
    tabs.addEventListener('pointercancel', fineTrascinamento);

    // --- rinomina ------------------------------------------------------------
    // Doppio click sul tab: l'etichetta diventa editabile in loco.
    // Invio o click fuori confermano, Esc annulla, campo vuoto ripristina
    // il nome di default.
    function rinomina(btn) {
      if (inModifica || gelo) return;
      var span = btn.querySelector('.etichetta');
      var id = btn.dataset.id;
      var precedente = span.textContent;
      var chiuso = false;

      inModifica = true;
      span.contentEditable = 'true';
      span.spellcheck = false;

      var r = document.createRange();
      r.selectNodeContents(span);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(r);
      span.focus();

      function chiudi(conferma) {
        if (chiuso) return;
        chiuso = true;
        inModifica = false;
        span.contentEditable = 'false';
        span.removeEventListener('keydown', onKeyEdit);
        span.removeEventListener('blur', onBlur);
        sel.removeAllRanges();

        if (conferma) {
          // niente newline: il contenteditable le lascia passare
          var nuovo = span.textContent.replace(/\s+/g, ' ').trim();
          salvaNome(id, nuovo && nuovo !== PREDEFINITI[id] ? nuovo : '');
          sincronizza();   // solo le rinomine VOLUTE salgono al server
          // Non si scrive il nome nello span: lo decide scriviEtichetta, che
          // sa se in questo momento vince l'automatico. Il contentEditable e'
          // gia' chiuso sopra, quindi non si autoesclude. [RR]
          scriviEtichetta(id);
        } else {
          span.textContent = precedente;
        }
        // il fuoco torna al terminale, altrimenti si scrive nel vuoto.
        // Prima si toglie dal pulsante: il doppio click ce l'aveva lasciato e
        // senza blur il tab resterebbe marcato dal browser. [RR]
        btn.blur();
        dagliIlFuoco(pannelloAttivo());
      }

      function onKeyEdit(e) {
        e.stopPropagation();               // non far navigare i tab mentre si scrive
        if (e.key === 'Enter') { e.preventDefault(); chiudi(true); }
        else if (e.key === 'Escape') { e.preventDefault(); chiudi(false); }
      }
      function onBlur() { chiudi(true); }

      span.addEventListener('keydown', onKeyEdit);
      span.addEventListener('blur', onBlur);
    }

    // Rinomina senza mouse il terminale con quell'id, che sia davanti o no: e'
    // il gemello di Alt+cifra, che allo stesso id ci salta. Il doppio click
    // resta, ma da tastiera non c'era modo di arrivarci, e su un portatile
    // senza mouse rinominare voleva dire prendere il trackpad e centrare un
    // tab. [RR]
    function rinominaPerId(id) {
      var btn = document.getElementById('term' + id + '-tab');
      if (btn) rinomina(btn);
    }

    tabs.addEventListener('dblclick', function (e) {
      var btn = e.target.closest('.nav-link');
      if (!btn) return;
      e.preventDefault();
      rinomina(btn);
    });

    // --- caricamento pigro ---------------------------------------------------
    // L'iframe (e quindi la websocket verso ttyd) nasce solo quando il tab viene
    // aperto la prima volta. Una volta creato non lo tocchiamo piu', altrimenti
    // si perderebbe lo scrollback del terminale. Riordinare i tab non ricrea
    // niente: si sposta il <li>, il pannello non viene toccato.
    function caricaPannello(pane) {
      if (!pane) return;
      var f = pane.querySelector('iframe');
      if (f) return f;
      f = document.createElement('iframe');
      f.setAttribute('title', pane.id);
      f.setAttribute('allow', 'clipboard-read; clipboard-write');
      // I tasti vanno agganciati DENTRO il documento dell'iframe: xterm.js
      // intercetta i keydown e il genitore non li vedrebbe mai. Same-origin,
      // quindi contentDocument e' accessibile.
      f.addEventListener('load', function () {
        agganciaTasti(f);
        agganciaCella(f, pane);
        agganciaOverlay(f, pane.id.slice(4));
        agganciaTitolo(f, pane.id.slice(4));
        attendiTerminale(pane, 100);
        if (pane.classList.contains('active') && !inModifica && !gelo) dagliIlFuoco(pane);
      });
      f.src = pane.dataset.src;
      pane.appendChild(f);
      return f;
    }

    // --- fuoco ---------------------------------------------------------------
    // Dopo il cambio tab il fuoco deve finire nel terminale nuovo, altrimenti
    // si continua a scrivere dove si era prima (o da nessuna parte).
    function dagliIlFuoco(pane) {
      var f = pane && pane.querySelector('iframe');
      if (!f) return;
      try {
        f.contentWindow.focus();
        var d = f.contentDocument;
        // xterm.js tiene il fuoco su una textarea nascosta; se il nome della
        // classe cambia in una versione futura, il focus sulla finestra basta.
        var ta = d && (d.querySelector('textarea.xterm-helper-textarea') || d.querySelector('textarea'));
        if (ta) ta.focus();
      } catch (err) { /* iframe non ancora pronto: ci pensa l'evento load */ }
    }

    // --- profilo sul server -------------------------------------------------
    // Nomi e ordine stanno in localStorage, che vale per QUESTO browser. Con i
    // profili accesi stanno anche sul server, in un JSON per identita', e
    // cambiando browser si ritrovano.
    //
    // L'identita' e' il CN del certificato client: la pagina non lo conosce,
    // glielo dice nginx su /io. Il file e' /profili/<cn>.json e nginx accetta
    // il PUT da se' col modulo DAV -- non c'e' nessun backend da interrogare.
    //
    // Regola di fondo: LA CACHE DISEGNA, IL SERVER RICONCILIA. I tab si
    // costruiscono subito da localStorage, come prima; quando (e se) arriva la
    // risposta si sistemano. Cosi' la pagina non aspetta la rete, e con i
    // profili spenti o il server irraggiungibile si comporta esattamente come
    // prima, senza un errore in console. [RR]
    var urlProfilo = null;      // null = nessun profilo: si resta su localStorage
    var attesaPut = null;

    function ordineCorrente() {
      return pulsanti().map(function (b) { return Number(b.dataset.id); });
    }

    // Debounce: trascinando i tab salvaOrdine parte a ogni rilascio, e senza
    // attesa si manderebbe una richiesta per ogni aggiustamento.
    function sincronizza(subito) {
      if (!urlProfilo) return;
      if (attesaPut) { clearTimeout(attesaPut); attesaPut = null; }
      function manda() {
        attesaPut = null;
        var corpo = JSON.stringify({
          nomi: leggi(CHIAVE_NOMI, {}), ordine: ordineCorrente(), griglia: statoGriglia(),
          agg: Number(leggi(CHIAVE_AGG, 0)) || 0
        });
        // keepalive: la PUT deve partire anche quando la manda mandaSubito()
        // mentre la pagina se ne sta andando -- una fetch normale, li', il
        // browser la annulla. Il corpo e' un paio di righe di JSON, ben
        // dentro il tetto di 64k che keepalive impone. [RR]
        fetch(urlProfilo, { method: 'PUT', body: corpo, cache: 'no-store', keepalive: true })
          .catch(function () { /* offline: localStorage ha comunque il dato, e la data dice che e' piu' fresco */ });
      }
      if (subito) manda(); else attesaPut = setTimeout(manda, 800);
    }

    // Un F5 dato SUBITO dopo aver rinominato non deve perdere niente: se c'e'
    // una PUT in attesa la si manda adesso invece di aspettare gli 800ms che
    // la pagina non vivra'. Anche chiudendo la scheda o passando ad un'altra
    // applicazione sul telefono. [RR]
    function mandaSubito() { if (attesaPut) sincronizza(true); }
    document.addEventListener('visibilitychange', function () { if (document.hidden) mandaSubito(); });
    window.addEventListener('pagehide', mandaSubito);

    function applicaProfilo(p) {
      if (!p || typeof p !== 'object') return;

      // CHI HA RAGIONE. Il profilo dal server vinceva sempre, e cosi' bastava
      // ricaricare entro gli 800ms del debounce -- o avere una PUT rifiutata,
      // o essere senza rete -- per veder tornare i nomi di prima: la modifica
      // era in localStorage, ma il caricamento dopo la sovrascriveva con la
      // copia vecchia del server. Adesso ogni modifica locale lascia una data
      // (CHIAVE_AGG) e la PUT la porta con se': se quella qui e' piu' recente
      // di quella del server, e' la cache ad avere ragione e a salire, non il
      // contrario.
      //
      // Sono orologi di macchine diverse, quindi non e' una verita' assoluta:
      // fra telefono e portatile sfasati vince chi ha l'orologio avanti. Ma
      // il caso che conta -- ho appena cambiato QUI e ricarico QUI -- e' lo
      // stesso browser, e li' la data e' ordinata per forza. [RR]
      var mia = Number(leggi(CHIAVE_AGG, 0)) || 0;
      var sua = Number(p.agg) || 0;
      if (mia > sua) { sincronizza(true); return; }

      if (p.nomi && typeof p.nomi === 'object') {
        scrivi(CHIAVE_NOMI, p.nomi);
        scriviEtichette();   // e dove il terminale ha un nome suo, resta quello
      }

      if (Array.isArray(p.ordine)) {
        // Solo id che esistono davvero, e in coda quelli che il profilo non
        // conosce (un terminale aggiunto dopo), come fa la costruzione
        // iniziale. Riordinare sposta i <li>: gli iframe non si toccano,
        // quindi ne' la sessione ne' lo scrollback ne soffrono.
        var visti = {}, finale = [];
        p.ordine.forEach(function (id) {
          id = Number(id);
          if (!visti[id] && document.getElementById('term' + id + '-tab')) { visti[id] = 1; finale.push(id); }
        });
        TERMINALS.forEach(function (t) { if (!visti[t.id]) finale.push(t.id); });
        finale.forEach(function (id) {
          var btn = document.getElementById('term' + id + '-tab');
          if (btn) tabs.insertBefore(btn.parentElement, barraDx);
        });
        scrivi(CHIAVE_ORDINE, finale);
      }

      // La griglia per ultima: le celle stanno nell'ordine dei tab, che il
      // blocco qui sopra puo' aver appena cambiato. Si ridispone anche quando
      // il profilo non parla di griglia (versione vecchia, o scritta da un
      // telefono): l'ordine nuovo va comunque applicato alle celle.
      if (p.griglia && typeof p.griglia === 'object') {
        var n = Number(p.griglia.celle);
        celleVolute = GRIGLIE.some(function (g) { return g.celle === n; }) ? n : 1;
        if (Array.isArray(p.griglia.ids)) idsGriglia = p.griglia.ids.map(Number);
      }
      var eff = celleEffettive();
      applicaGriglia(eff > 1 ? ripulisci(idsGriglia, eff) : []);
      scrivi(CHIAVE_GRIGLIA, statoGriglia());

      // Adesso questo browser ha esattamente cio' che ha il server: la data
      // diventa la sua, non l'ora in cui e' arrivata la risposta.
      scrivi(CHIAVE_AGG, sua);
    }

    function caricaProfilo() {
      if (!window.fetch) return;   // browser troppo vecchio: localStorage e basta
      fetch('/io', { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.text() : null; })
        .then(function (id) {
          id = (id || '').trim();
          // /io che non risponde vuol dire profili spenti nel vhost; identita'
          // vuota vuol dire che nginx non ha ricavato un CN utilizzabile dal
          // certificato. In entrambi i casi si resta su localStorage.
          if (!/^[A-Za-z0-9._-]{1,64}$/.test(id)) return;
          urlProfilo = '/profili/' + encodeURIComponent(id) + '.json';
          return fetch(urlProfilo, { cache: 'no-store' }).then(function (r) {
            // 404 = primo accesso con questa identita': si semina il profilo
            // con quello che questo browser ha gia', invece di partire vuoti.
            if (r.status === 404) { sincronizza(true); return; }
            // 403 e simili arrivano con un corpo di testo, non JSON: si lascia
            // stare senza provare a interpretarlo.
            if (!r.ok) return;
            return r.json().then(applicaProfilo, function () {});
          });
        })
        .catch(function () { /* rete o CSP: si resta su localStorage */ });
    }

    // --- adattamento allo schermo -------------------------------------------
    // Unico posto dove stanno i limiti: il CSS non ha media query sue, reagisce
    // alle classi che mettiamo qui sul body. I tab di Bootstrap a misura da
    // desktop, per dieci terminali su un telefono, occupano tre righe di
    // schermo che vengono tolte al terminale.
    //
    // Al font si mette mano perche' la larghezza in colonne dipende da quello:
    // a 13px su un telefono da 390px ci stanno una cinquantina di colonne, a
    // 11px una sessantina, e la differenza si vede in htop o in un diff.
    // Il limite e' il NUMERO: la media query si ricava da quello, cosi' la
    // misura resta scritta una volta sola anche adesso che la si confronta
    // pure con la larghezza di una cella (vedi schermoDi).
    var SCHERMI = [
      { classe: 'schermo-piccolo', max: 480, font: 11 },
      { classe: 'schermo-medio',   max: 900, font: 12 }
    ];
    SCHERMI.forEach(function (x) { x.query = '(max-width: ' + x.max + 'px)'; });

    // La scelta a mano con A− / A+ batte l'automatico. Sta in localStorage e
    // NON nel profilo sul server, di proposito: la dimensione giusta dipende
    // dallo schermo che hai davanti, e un valore condiviso fra telefono e
    // portatile sarebbe sbagliato su almeno uno dei due. [RR]
    var CHIAVE_FONT = 'terminal-dashboard-font';
    var FONT_MIN = 8, FONT_MAX = 24;

    function fontAMano() {
      var n = Number(leggi(CHIAVE_FONT, 0));
      return (n >= FONT_MIN && n <= FONT_MAX) ? n : 0;   // 0 = automatico
    }

    // Il primo che corrisponde vince: 'piccolo' sta prima perche' la sua
    // larghezza soddisfa anche la query di 'medio'.
    function schermoAttuale() {
      for (var i = 0; i < SCHERMI.length; i++) {
        try { if (window.matchMedia(SCHERMI[i].query).matches) return SCHERMI[i]; }
        catch (err) { return null; }   // niente matchMedia: si resta al default
      }
      return null;                     // schermo largo: tutto come lo fa ttyd
    }

    // In griglia la larghezza che conta non e' quella della finestra ma quella
    // della CELLA: un 1920 diviso in tre da' celle da 630, e li' il font giusto
    // e' quello che si userebbe su uno schermo da 630. Fuori dalla griglia il
    // pannello e' largo quanto la finestra, e questa ritorna quello che
    // ritornava schermoAttuale(). [RR]
    function schermoDi(pane) {
      var l = 0;
      try { l = pane ? pane.getBoundingClientRect().width : 0; } catch (err) {}
      if (!l) return schermoAttuale();   // pannello nascosto: non c'e' niente da misurare
      for (var i = 0; i < SCHERMI.length; i++) if (l <= SCHERMI[i].max) return SCHERMI[i];
      return null;
    }

    function classiSchermo() {
      var s = schermoAttuale();
      SCHERMI.forEach(function (x) { document.body.classList.toggle(x.classe, x === s); });
    }

    // Il font di partenza non si scrive qui: si legge dal terminale la prima
    // volta che lo si vede. Cosi' tornando su uno schermo largo si rimette
    // quello di ttyd (13px oggi) invece di un numero copiato a mano che
    // domani non e' piu' vero.
    function adattaFont(pane) {
      var term = termDi(pane);
      if (!term) return;
      try {
        if (!pane.dataset.fontTtyd) pane.dataset.fontTtyd = String(term.options.fontSize);
        var s = schermoDi(pane);
        var voluto = fontAMano() || (s && s.font) || Number(pane.dataset.fontTtyd);
        if (term.options.fontSize === voluto) return;
        term.options.fontSize = voluto;
        // Cambiare fontSize ridisegna il testo ma NON ricalcola righe e
        // colonne: senza il fit, il pty resta convinto di avere le dimensioni
        // di prima e le interfacce a tutto schermo escono storte. ttyd espone
        // il fit del FitAddon come window.term.fit.
        if (typeof term.fit === 'function') term.fit();
        else {
          var f = pane.querySelector('iframe');
          // ttyd rifa' il fit sul resize della propria finestra: se un domani
          // .fit non ci fosse piu', il resize e' la strada di riserva.
          if (f && f.contentWindow) f.contentWindow.dispatchEvent(new Event('resize'));
        }
      } catch (err) { /* iframe non pronto: ci pensa attendiTerminale */ }
    }

    function adattaTutto() {
      classiSchermo();
      Array.prototype.forEach.call(panes.querySelectorAll('.tab-pane'), adattaFont);
    }

    // window.term nasce un attimo dopo il load dell'iframe, come .xterm: si
    // riprova qualche volta invece di indovinare un ritardo fisso.
    function attendiTerminale(pane, quanti) {
      if (termDi(pane)) { adattaFont(pane); return; }
      if (quanti > 0) setTimeout(function () { attendiTerminale(pane, quanti - 1); }, 100);
    }

    // Rotazione del telefono, finestra ridimensionata, tastiera di sistema che
    // si apre: cambia la classe e con essa il font.
    SCHERMI.forEach(function (x) {
      try {
        var mq = window.matchMedia(x.query);
        if (mq.addEventListener) mq.addEventListener('change', adattaTutto);
        else if (mq.addListener) mq.addListener(adattaTutto);   // Safari vecchi
      } catch (err) {}
    });

    // --- dimensione dei caratteri -------------------------------------------
    // Quanto vale adesso, per il passo e per l'etichetta dei bottoni.
    function fontAdesso() {
      var term = termDi(pannelloAttivo());
      try { if (term && term.options.fontSize) return Number(term.options.fontSize); }
      catch (err) {}
      var s = schermoDi(pannelloAttivo());
      return fontAMano() || (s && s.font) || 13;
    }

    // Il valore che l'automatico sceglierebbe adesso: serve per capire quando
    // la scelta a mano si puo' buttare.
    function fontAutomatico() {
      var pane = pannelloAttivo();
      var s = schermoDi(pane);
      return (s && s.font) || Number(pane && pane.dataset.fontTtyd) || 13;
    }

    function cambiaFont(passo) {
      var n = fontAdesso() + passo;
      if (n < FONT_MIN || n > FONT_MAX) return;
      // Tornando esattamente sul valore che l'automatico avrebbe scelto, la
      // scelta a mano viene buttata: cosi' si torna ad adattarsi allo schermo
      // (ruotando il telefono, per esempio) senza un terzo bottone "auto".
      scrivi(CHIAVE_FONT, n === fontAutomatico() ? 0 : n);
      adattaTutto();
      etichetteFont();
    }

    function etichetteFont() {
      var n = fontAdesso();
      var come = fontAMano() ? 'scelta' : 'automatica';
      bottoneGiu.title = 'Caratteri piu' + '’ piccoli (adesso ' + n + 'px, ' + come + ')';
      bottoneSu.title  = 'Caratteri piu' + '’ grandi (adesso ' + n + 'px, ' + come + ')';
      // Il bottone e' due lettere: senza questo, a chi legge lo schermo
      // arriverebbe "A a" e nient'altro.
      bottoneGiu.setAttribute('aria-label', bottoneGiu.title);
      bottoneSu.setAttribute('aria-label', bottoneSu.title);
      bottoneGiu.disabled = n <= FONT_MIN;
      bottoneSu.disabled  = n >= FONT_MAX;
    }

    bottoneGiu.addEventListener('click', function () { cambiaFont(-1); });
    bottoneSu.addEventListener('click',  function () { cambiaFont(+1); });

    // --- griglia: 2, 4 o 6 terminali insieme ---------------------------------
    // Solo dove c'e' spazio: sotto i ~600px per cella un terminale non tiene
    // 80 colonne a un font leggibile, e sei finestrelle illeggibili valgono
    // meno di una sola che si legge. Le soglie stanno qui, il CSS reagisce
    // alle classi che mettiamo sul body -- stesso patto di SCHERMI.
    //
    // COS'E' LA SELEZIONE. La griglia e' un INSIEME di terminali, non
    // un'assegnazione cella per cella: l'ordine in cui compaiono e' quello dei
    // tab, percio' le celle si spostano trascinando i tab come sempre, senza
    // imparare un secondo modo di riordinare. Da qui una regola sola per il
    // click su un tab, per Alt+cifra e per Shift+frecce:
    //
    //     vai al terminale X = se e' gia' a schermo, la sua cella diventa
    //     quella attiva; se non c'e', X prende il posto della cella attiva.
    //
    // Lo stesso terminale non puo' stare in due celle, e non e' una scelta di
    // gusto: sono due client sulla stessa sessione tmux, e tmux dimensiona la
    // finestra sul client piu' piccolo -- le due celle si strozzerebbero a
    // vicenda. [RR]
    var GRIGLIE = [
      { celle: 2, query: '(min-width: 1200px)' },
      { celle: 4, query: '(min-width: 1500px) and (min-height: 800px)' },
      { celle: 6, query: '(min-width: 1900px) and (min-height: 800px)' }
    ];
    var CHIAVE_GRIGLIA = 'terminal-dashboard-griglia';

    var celleVolute = 1;   // la PREFERENZA, anche quando lo schermo non la regge
    var idsGriglia = [];   // i terminali a schermo adesso; meno di due = griglia spenta

    function disponibili() {
      var out = [];
      GRIGLIE.forEach(function (g) {
        try { if (window.matchMedia(g.query).matches) out.push(g.celle); }
        catch (err) { /* niente matchMedia: niente griglia, e la pagina resta quella di prima */ }
      });
      return out;
    }

    // La preferenza puo' valere piu' di quello che lo schermo regge: sul
    // telefono resta salvata e non si applica, invece di essere azzerata. Il
    // profilo e' condiviso fra browser, e il telefono non deve buttare la
    // griglia scelta sul portatile. Se lo spazio basta per meno celle di
    // quelle chieste si usa il formato piu' grande che ci sta. [RR]
    function celleEffettive() {
      var d = disponibili(), n = 1;
      for (var i = 0; i < d.length; i++) if (d[i] <= celleVolute) n = d[i];
      return n;
    }

    function celleAdesso() { return idsGriglia.length > 1 ? idsGriglia.length : 1; }
    function statoGriglia() { return { celle: celleVolute, ids: idsGriglia }; }
    function pannelloDi(id) { return document.getElementById('term' + id); }
    function idDi(pane) { return pane ? Number(pane.id.slice(4)) : NaN; }

    // Chi entra in griglia quando la si apre: il terminale attivo e i
    // successivi nell'ordine dei tab, ciclico come Shift+frecce.
    function insiemeIniziale(n) {
      var ord = ordineCorrente();
      var i = ord.indexOf(idDi(pannelloAttivo()));
      if (i < 0) i = 0;
      var out = [];
      for (var k = 0; k < n && k < ord.length; k++) out.push(ord[(i + k) % ord.length]);
      return out;
    }

    // Tiene solo id che esistono davvero, senza ripetizioni, e completa con i
    // successivi se il profilo ne portava meno di n: un profilo scritto da una
    // versione futura, o da uno schermo piu' grande, non deve lasciare celle
    // vuote ne' due volte lo stesso terminale.
    function ripulisci(ids, n) {
      var visti = {}, out = [];
      (Array.isArray(ids) ? ids : []).forEach(function (id) {
        id = Number(id);
        if (!visti[id] && pannelloDi(id) && out.length < n) { visti[id] = 1; out.push(id); }
      });
      insiemeIniziale(n).forEach(function (id) {
        if (!visti[id] && out.length < n) { visti[id] = 1; out.push(id); }
      });
      return out;
    }

    function applicaGriglia(ids) {
      idsGriglia = ids;
      var n = celleAdesso();
      var dentro = {};
      ids.forEach(function (id) { dentro[id] = 1; });

      // L'ordine delle celle e' quello dei tab: si riscrive su TUTTI i
      // pannelli, cosi' dopo un trascinamento basta richiamare questa.
      ordineCorrente().forEach(function (id, i) {
        var pane = pannelloDi(id);
        if (!pane) return;
        pane.style.order = i;
        pane.classList.toggle('in-griglia', n > 1 && !!dentro[id]);
      });

      document.body.classList.toggle('griglia', n > 1);
      GRIGLIE.forEach(function (g) {
        document.body.classList.toggle('griglia-' + g.celle, n === g.celle);
      });

      // La cella attiva dev'essere una di quelle a schermo, o i tasti
      // andrebbero a un terminale che non si vede.
      if (n > 1 && !dentro[idDi(pannelloAttivo())]) {
        var primo = ordineCorrente().filter(function (id) { return dentro[id]; })[0];
        if (primo !== undefined) vaiPerId(primo);
      }
      ids.forEach(function (id) { caricaPannello(pannelloDi(id)); });

      etichetteGriglia();
      // Le celle hanno una misura nuova. Il fit del terminale lo rifa' ttyd da
      // se' sul resize del proprio iframe; il font invece lo decidiamo noi e
      // dipende dalla larghezza della cella, che esiste solo dopo che il
      // browser ha disposto la griglia -- quindi non adesso, ma subito dopo.
      setTimeout(adattaTutto, 0);
      setTimeout(adattaTutto, 200);
    }

    // La regola unica, applicata dove i tab cambiano davvero: shown.bs.tab
    // scatta per il click sul tab, per Alt+cifra e per Shift+frecce, quindi
    // basta questa e non ci sono tre strade da tenere allineate.
    // e.relatedTarget e' il tab di PRIMA, cioe' la cella che stiamo lasciando:
    // e' quella che cede il posto.
    function sostituisciCella(nuovo, tabPrima) {
      var id = idDi(nuovo);
      if (idsGriglia.indexOf(id) >= 0) return;   // gia' a schermo: cambia solo la cella attiva
      var uscente = tabPrima ? Number(tabPrima.dataset.id) : idsGriglia[0];
      var i = idsGriglia.indexOf(uscente);
      if (i < 0) i = idsGriglia.length - 1;      // cella di prima sconosciuta: cede l'ultima
      var ids = idsGriglia.slice();
      ids[i] = id;
      applicaGriglia(ids);
      salvaGriglia();
    }

    // Cliccare DENTRO un terminale non arriva al genitore: l'evento resta nel
    // documento dell'iframe. Per sapere quale cella riceve i tasti si ascolta
    // li' dentro, come si fa gia' per i tasti speciali. Da qui si passa per
    // vaiPerId, cosi' cambiare cella col mouse e cambiarla con Shift+frecce
    // finiscono nello stesso posto. [RR]
    function agganciaCella(f, pane) {
      try {
        var d = f.contentDocument;
        if (!d || d.__cellaAgganciata) return;
        d.__cellaAgganciata = true;
        function scegli() {
          if (idsGriglia.length < 2 || inModifica) return;
          if (pane.classList.contains('active')) return;
          vaiPerId(idDi(pane));
        }
        d.addEventListener('pointerdown', scegli, true);
        d.addEventListener('focusin', scegli, true);
      } catch (err) { /* iframe non leggibile: la cella si sceglie dai tab */ }
    }

    function salvaGriglia() {
      scrivi(CHIAVE_GRIGLIA, statoGriglia());
      tocca();
      sincronizza();
    }

    function apriGriglia(n) {
      celleVolute = n;
      var eff = celleEffettive();
      applicaGriglia(eff > 1 ? ripulisci(idsGriglia, eff) : []);
      salvaGriglia();
    }

    // Il ciclo salta i formati che lo schermo non regge: su un portatile da
    // 1366 il bottone fa 1 <-> 2 e basta, senza passare per stati che non si
    // possono vedere.
    function commutaGriglia() {
      if (gelo || inModifica) return;
      var scelte = [1].concat(disponibili());
      if (scelte.length < 2) return;
      var i = scelte.indexOf(celleAdesso());
      apriGriglia(scelte[(i + 1) % scelte.length]);
    }

    function etichetteGriglia() {
      var scelte = disponibili();
      var n = celleAdesso();
      bottoneGriglia.style.display = scelte.length ? '' : 'none';
      bottoneGriglia.textContent = n > 1 ? '⊞ ' + n : '⊞ Griglia';
      bottoneGriglia.classList.toggle('acceso', n > 1);
      bottoneGriglia.setAttribute('aria-pressed', n > 1 ? 'true' : 'false');
      bottoneGriglia.title = 'Terminali insieme: ' + [1].concat(scelte).join(' → ') +
        ' → … (Ctrl+Alt+G)';
    }

    bottoneGriglia.addEventListener('click', commutaGriglia);

    // Finestra ridimensionata: se lo spazio non basta piu' la griglia si
    // stringe da se'. La PREFERENZA non si tocca, percio' riallargando si
    // ritrova il formato di prima senza doverlo richiedere.
    GRIGLIE.forEach(function (g) {
      try {
        var mq = window.matchMedia(g.query);
        var f = function () {
          var eff = celleEffettive();
          if (eff === celleAdesso()) { etichetteGriglia(); return; }
          applicaGriglia(eff > 1 ? ripulisci(idsGriglia, eff) : []);
        };
        if (mq.addEventListener) mq.addEventListener('change', f);
        else if (mq.addListener) mq.addListener(f);   // Safari vecchi
      } catch (err) {}
    });

    // All'avvio: la preferenza salvata, applicata solo per quanto lo schermo
    // regge. Va chiamata dopo il primo pannello, perche' gli altri iframe
    // nascono qui.
    function avviaGriglia() {
      var salvato = leggi(CHIAVE_GRIGLIA, null);
      if (salvato && typeof salvato === 'object') {
        var n = Number(salvato.celle);
        celleVolute = GRIGLIE.some(function (g) { return g.celle === n; }) ? n : 1;
        if (Array.isArray(salvato.ids)) idsGriglia = salvato.ids.map(Number);
      }
      var eff = celleEffettive();
      applicaGriglia(eff > 1 ? ripulisci(idsGriglia, eff) : []);
    }

    // --- modalita' storia (copy-mode di tmux) --------------------------------
    // Ctrl-B [ mette tmux in copy-mode: le frecce e PagSu/Giu smettono di
    // andare al programma e scorrono lo scrollback. Il guaio e' che da fuori
    // non si vede, e ci si ritrova a premere tasti che non fanno quello che
    // si crede.
    //
    // COME SI SA SE E' ATTIVA. Non tenendo il conto dei nostri click: chi usa
    // una tastiera vera puo' entrarci e uscirne da se', e una spia che mente e'
    // peggio di nessuna spia. Si guarda invece cio' che tmux DISEGNA: in
    // copy-mode scrive l'indicatore di posizione [riga/totale] in alto a
    // destra del pannello, e quel disegno finisce nel buffer di xterm.js.
    // Verificato registrando il pty di un client tmux vero: entrando in
    // copy-mode compare "[0/179]". [RR]
    var storiaAttiva = false;

    function inStoria(term) {
      try {
        var buf = term.buffer.active;
        var linea = buf.getLine(buf.viewportY);       // prima riga a schermo
        if (!linea) return false;
        // translateToString(true) taglia gli spazi a destra, quindi
        // l'indicatore, che sta al margine destro, finisce in fondo.
        var testo = linea.translateToString(true);
        var m = /\[\d+\/\d+\]$/.exec(testo);
        if (!m) return false;

        // Il testo puo' finire per caso con qualcosa come "[1/10]": una barra
        // di avanzamento accenderebbe la spia, e una spia che mente e' peggio
        // di nessuna spia. Quello di tmux e' disegnato con mode-style, che di
        // serie e' bg=yellow: si chiede percio' allo SFONDO delle celle. Su
        // testo normale lo sfondo e' quello di default. [RR]
        for (var x = m.index; x < testo.length; x++) {
          var cella = linea.getCell(x);
          if (cella && !cella.isBgDefault()) return true;
        }
        return false;
      } catch (err) { return false; }
    }

    function mostraStoria() {
      document.body.classList.toggle('storia', storiaAttiva);
      bottoneStoria.classList.toggle('acceso', storiaAttiva);
      bottoneStoria.setAttribute('aria-pressed', storiaAttiva ? 'true' : 'false');
      bottoneStoria.title = storiaAttiva
        ? 'Esci dalla storia e torna al terminale (Esc)'
        : 'Scorri la storia del terminale (come Ctrl-B [)';
    }

    function guardaStoria() {
      if (document.hidden) return;                    // scheda in secondo piano
      var term = termDi(pannelloAttivo());
      var ora = !!term && !gelo && inStoria(term);
      if (ora === storiaAttiva) return;
      storiaAttiva = ora;
      mostraStoria();
    }

    // Un giro d'orologio corto: leggere una riga di buffer costa niente, e la
    // spia deve seguire anche chi entra in copy-mode con la tastiera.
    setInterval(guardaStoria, 400);
    document.addEventListener('visibilitychange', guardaStoria);
    tabs.addEventListener('shown.bs.tab', function () { setTimeout(guardaStoria, 60); });

    function commutaStoria() {
      if (gelo || inModifica) return;
      var term = termDi(pannelloAttivo());
      if (!term) return;
      // Per uscire si manda Esc e non 'q': Esc annulla la copy-mode in
      // entrambe le tabelle di tmux (emacs e vi) e, se lo stato rilevato
      // fosse sbagliato, fuori dalla copy-mode non fa danni -- mentre 'q'
      // scriverebbe una lettera nella shell.
      // Per entrare, il prefisso Ctrl-B (0x02) seguito da '['.
      try { term.input(storiaAttiva ? '\x1b' : '\x02['); } catch (err) {}
      setTimeout(guardaStoria, 120);   // il rilevamento conferma o smentisce
    }
    bottoneStoria.addEventListener('click', commutaStoria);

    // --- tasti che un telefono non ha ---------------------------------------
    // La tastiera di sistema di un telefono non ha Tab, Esc, frecce ne'
    // PagSu/PagGiu: dentro tmux o vi si resta bloccati, e senza Tab non si
    // completa un nome di file. Questi bottoni li mandano al terminale.
    //
    // Si scrive con term.input(), l'API con cui xterm.js inietta dati "come
    // se li avesse digitati l'utente" (finisce in triggerDataEvent). Due
    // proprieta' utili: non richiede che il fuoco sia nel terminale, e
    // rispetta disableStdin, percio' col pannello congelato questi tasti non
    // passano esattamente come non passa la tastiera vera. [RR]
    var CHIAVE_TASTIERA = 'terminal-dashboard-tastiera';

    // Le frecce hanno DUE forme. Col modo cursore "applicazione" attivo
    // (DECCKM, lo accendono vi e in genere le interfacce a tutto schermo)
    // sono ESC O <lettera>, altrimenti ESC [ <lettera>. Mandare sempre la
    // seconda funziona nella shell e si rompe altrove, quindi si guarda in
    // che modo si trova il terminale in quel momento.
    var TASTI = [
      { et: 'Esc',    seq: '\x1b' },
      { et: 'Tab',    seq: '\t' },
      { et: '←',      cur: 'D' },
      { et: '↑',      cur: 'A' },
      { et: '↓',      cur: 'B' },
      { et: '→',      cur: 'C' },
      { et: 'PagSu',  seq: '\x1b[5~' },
      { et: 'PagGiu', seq: '\x1b[6~' }
    ];

    function sequenza(t, term) {
      if (!t.cur) return t.seq;
      var app = false;
      try { app = !!(term && term.modes && term.modes.applicationCursorKeysMode); }
      catch (err) { /* xterm senza .modes: si ripiega sulla forma normale */ }
      return (app ? '\x1bO' : '\x1b[') + t.cur;
    }

    function mandaTasto(t) {
      if (gelo || inModifica) return;
      var term = termDi(pannelloAttivo());
      if (!term) return;
      try { term.input(sequenza(t, term)); } catch (err) {}
    }

    // Un tasto vero, tenuto premuto, si ripete: senza, per risalire dieci
    // comandi nella storia servono dieci tap.
    var attesaRip = null, rip = null;
    function fermaRipetizione() {
      if (attesaRip) { clearTimeout(attesaRip); attesaRip = null; }
      if (rip) { clearInterval(rip); rip = null; }
    }

    var tastiera = document.getElementById('tastiera');

    var spia = document.createElement('span');
    spia.className = 'spia';
    spia.textContent = '⇱ storia · le frecce scorrono';
    tastiera.appendChild(spia);

    TASTI.forEach(function (t) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'tasto';
      b.textContent = t.et;
      b.title = t.et;
      // pointerdown con preventDefault, non click: sul telefono premere un
      // bottone sposterebbe il fuoco fuori dal terminale e la tastiera di
      // sistema si chiuderebbe a ogni tasto. Prevenendo il default il fuoco
      // non si muove, e il tasto parte alla pressione invece che al rilascio.
      b.addEventListener('pointerdown', function (e) {
        e.preventDefault();
        fermaRipetizione();
        mandaTasto(t);
        // la cattura tiene il pointerup su questo bottone anche se il dito
        // scivola via: senza, la ripetizione non si fermerebbe piu'
        try { b.setPointerCapture(e.pointerId); } catch (err) {}
        attesaRip = setTimeout(function () {
          attesaRip = null;
          rip = setInterval(function () { mandaTasto(t); }, 60);
        }, 400);
      });
      b.addEventListener('pointerup', fermaRipetizione);
      b.addEventListener('pointercancel', fermaRipetizione);
      tastiera.appendChild(b);
    });

    // Rete di sicurezza: se il pointerup si perde per strada (cambio di
    // scheda, gesto di sistema, schermo che si spegne) la ripetizione va
    // fermata comunque, o continua a mandare tasti a un terminale che nessuno
    // sta guardando.
    window.addEventListener('blur', fermaRipetizione);
    document.addEventListener('visibilitychange', fermaRipetizione);

    // Di serie la barra compare dove il puntatore e' un dito. Una scelta
    // esplicita vince e viene ricordata: si salva 'si'/'no' e non un booleano
    // perche' leggi() non distingue un false salvato da un valore assente.
    function mostraTastiera(mostra) {
      document.body.classList.toggle('mostra-tastiera', mostra);
      bottoneTastiera.title = (mostra ? 'Nascondi' : 'Mostra') +
        ' i tasti Tab, Esc, frecce, PagSu/PagGiu';
      bottoneTastiera.setAttribute('aria-pressed', mostra ? 'true' : 'false');
    }
    var sceltaTastiera = leggi(CHIAVE_TASTIERA, '');
    var conIlDito = false;
    try { conIlDito = !!(window.matchMedia && window.matchMedia('(pointer: coarse)').matches); }
    catch (err) {}
    mostraTastiera(sceltaTastiera === 'si' || (sceltaTastiera !== 'no' && conIlDito));

    bottoneTastiera.addEventListener('click', function () {
      var mostra = !document.body.classList.contains('mostra-tastiera');
      mostraTastiera(mostra);
      scrivi(CHIAVE_TASTIERA, mostra ? 'si' : 'no');
      // il terminale e' cambiato di altezza: ttyd rifa' il fit sul resize
      // della sua finestra, che l'iframe emette da se'.
    });

    // --- finestra dell'aiuto -------------------------------------------------
    // L'elenco delle scorciatoie stava in un rigo di testata che spariva sotto
    // i 1100px: era leggibile solo dove c'era spazio per fare a meno di
    // leggerlo. Qui invece ci sta tutto, anche i gesti col mouse e i bottoni,
    // e su un telefono si legge come sul portatile. [RR]
    var AIUTO = [
      { titolo: 'Terminali', voci: [
        { tasti: ['Shift+←', 'Shift+→'], che: 'terminale precedente e successivo, nell\'ordine dei tab' },
        { tasti: ['Alt+0', 'Alt+9'], che: 'salta al terminale con quell\'id, ovunque sia finito' },
        { tasti: ['Ctrl+0', 'Ctrl+9'], che: 'rinomina il terminale con quell\'id: Invio conferma, Esc annulla, vuoto rimette il nome di serie' },
        { gesto: 'doppio click sul tab', che: 'rinomina quel tab, come Ctrl+cifra' },
        { gesto: 'trascina il tab', che: 'cambia l\'ordine dei terminali' },
        { tasti: ['Ctrl+Alt+N'], che: 'nome dei tab: titolo dell\'applicazione, comando in esecuzione, solo i nomi scritti da te (come il bottone 🏷)' }
      ] },
      { titolo: 'Piu\' terminali insieme', voci: [
        { tasti: ['Ctrl+Alt+G'], che: 'uno solo → 2 → 4 → 6, fra i formati che lo schermo regge' },
        { gesto: 'clic su un tab', che: 'in griglia: se quel terminale non e\' a schermo, entra nella cella attiva; se c\'e\' gia\', la sua cella diventa quella attiva' },
        { gesto: 'clic dentro un terminale', che: 'sceglie la cella attiva, quella con la cornice verde: e\' lei che riceve tasti, congelamento e storia' }
      ] },
      { titolo: 'Copiare', voci: [
        { tasti: ['Ctrl+Alt+C'], che: 'congela il terminale: l\'output si ferma e il testo si seleziona col mouse' },
        { tasti: ['Ctrl+Ins'], che: 'copia la selezione fatta dentro il terminale, senza congelare' },
        { tasti: ['Esc'], che: 'a terminale congelato, riprende' }
      ] },
      { titolo: 'Bottoni in testata', voci: [
        { gesto: 'A›a  a›A', che: 'caratteri piu\' piccoli e piu\' grandi; la scelta batte l\'automatico e resta su questo browser' },
        { gesto: '🏷 Titolo / Comando / Nomi miei', che: 'da dove viene il nome dei tab. L\'automatico ha la precedenza sui nomi scritti a mano, che restano salvati e tornano appena il terminale non ha un titolo suo' },
        { gesto: '⊞ Griglia', che: 'quanti terminali a schermo; compare solo dove c\'e\' spazio' },
        { gesto: '⌨ Tasti', che: 'la barra con Esc, Tab, frecce e PagSu/PagGiu, per le tastiere che non li hanno' },
        { gesto: '⇱ Storia', che: 'entra e esce dalla copy-mode di tmux (Ctrl-B [): li\' le frecce scorrono lo scrollback' },
        { gesto: '❄ Congela', che: 'come Ctrl+Alt+C' }
      ] },
      { titolo: 'Questa finestra', voci: [
        { tasti: ['Ctrl+H'], che: 'apre e chiude questo elenco' },
        { tasti: ['Esc'], che: 'chiude' }
      ] }
    ];

    var aiuto = null;

    function apriAiuto() {
      if (aiuto || inModifica) return;

      var fondo = document.createElement('div');
      fondo.className = 'aiuto';

      var carta = document.createElement('div');
      carta.className = 'aiuto-carta';

      var testata = document.createElement('div');
      testata.className = 'aiuto-testata';
      var titolo = document.createElement('strong');
      titolo.textContent = 'Scorciatoie';
      var bChiudi = document.createElement('button');
      bChiudi.type = 'button';
      bChiudi.className = 'bottone-gela';
      bChiudi.textContent = 'Chiudi (Esc)';
      testata.appendChild(titolo);
      testata.appendChild(bChiudi);

      var corpo = document.createElement('div');
      corpo.className = 'aiuto-corpo';
      AIUTO.forEach(function (sezione) {
        var h = document.createElement('h3');
        h.textContent = sezione.titolo;
        corpo.appendChild(h);

        var dl = document.createElement('dl');
        sezione.voci.forEach(function (v) {
          var dt = document.createElement('dt');
          if (v.tasti) {
            v.tasti.forEach(function (t, i) {
              if (i) {
                var sep = document.createElement('span');
                sep.className = 'sep';
                sep.textContent = '…';
                dt.appendChild(sep);
              }
              var k = document.createElement('kbd');
              k.textContent = t;
              dt.appendChild(k);
            });
          } else {
            var g = document.createElement('span');
            g.className = 'gesto';
            g.textContent = v.gesto;
            dt.appendChild(g);
          }
          var dd = document.createElement('dd');
          dd.textContent = v.che;
          dl.appendChild(dt);
          dl.appendChild(dd);
        });
        corpo.appendChild(dl);
      });

      var coda = document.createElement('p');
      coda.textContent = 'Nomi e ordine dei tab, e la griglia, seguono l\'identita\' del ' +
        'certificato: li ritrovi cambiando browser.';
      corpo.appendChild(coda);

      carta.appendChild(testata);
      carta.appendChild(corpo);
      fondo.appendChild(carta);
      document.body.appendChild(fondo);

      bChiudi.addEventListener('click', chiudiAiuto);
      // Solo il fondo, non la carta: un click sul testo non deve chiudere
      // quello che si sta leggendo.
      fondo.addEventListener('pointerdown', function (e) { if (e.target === fondo) chiudiAiuto(); });

      aiuto = fondo;
      bottoneAiuto.classList.add('acceso');
      bottoneAiuto.setAttribute('aria-pressed', 'true');
      // Il fuoco esce dal terminale: cosi' Esc arriva qui e non al programma
      // che gira nel pannello.
      try { bChiudi.focus(); } catch (err) {}
    }

    function chiudiAiuto() {
      if (!aiuto) return;
      if (aiuto.parentNode) aiuto.parentNode.removeChild(aiuto);
      aiuto = null;
      bottoneAiuto.classList.remove('acceso');
      bottoneAiuto.setAttribute('aria-pressed', 'false');
      // il fuoco torna dove si stava scrivendo, o si scriverebbe nel vuoto
      if (!gelo && !inModifica) dagliIlFuoco(pannelloAttivo());
    }

    function commutaAiuto() { aiuto ? chiudiAiuto() : apriAiuto(); }

    bottoneAiuto.title = 'Elenco delle scorciatoie (Ctrl+H)';
    bottoneAiuto.setAttribute('aria-pressed', 'false');
    bottoneAiuto.addEventListener('click', commutaAiuto);

    // --- tastiera ------------------------------------------------------------
    function onTasto(e) {
      if (inModifica) return;

      // Ctrl+H apre e chiude l'elenco delle scorciatoie.
      //
      // Va detto che nel terminale Ctrl+H e' ^H, cioe' backspace per readline
      // e per vi in inserimento: intercettandolo qui, chi cancella cosi' non
      // cancella piu'. E' la scorciatoia chiesta, ed e' l'unica di questa
      // pagina che non passa da Ctrl+Alt: se dovesse dare fastidio, cambiarla
      // e' una riga sola (per esempio F1, o Ctrl+Alt+H come le altre). [RR]
      if (e.ctrlKey && !e.altKey && !e.metaKey && (e.key === 'h' || e.key === 'H')) {
        e.preventDefault(); e.stopPropagation();
        commutaAiuto();
        return;
      }
      // Con l'elenco aperto i tasti restano qui: Esc chiude, il resto non
      // finisce nel terminale che sta dietro.
      if (aiuto) {
        if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); chiudiAiuto(); }
        return;
      }

      // Ctrl+Alt+C congela / riprende. Con il pannello congelato, Esc riprende.
      if (e.ctrlKey && e.altKey && !e.metaKey && (e.key === 'c' || e.key === 'C')) {
        e.preventDefault(); e.stopPropagation();
        gelo ? scongela() : congela();
        return;
      }
      if (gelo) {
        if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); scongela(); }
        return;   // congelati non si naviga: il tab resta quello che stai copiando
      }

      // Ctrl+Alt+G cicla la griglia. Dopo il blocco del congelamento: a
      // pannello congelato si sta copiando, e cambiare il numero di celle
      // sposterebbe sotto il mouse proprio il testo che si sta selezionando.
      if (e.ctrlKey && e.altKey && !e.metaKey && (e.key === 'g' || e.key === 'G')) {
        e.preventDefault(); e.stopPropagation();
        commutaGriglia();
        return;
      }

      // Ctrl+Alt+N cicla il nome dei tab: titolo dell'applicazione, comando in
      // esecuzione, solo i nomi scritti a mano.
      if (e.ctrlKey && e.altKey && !e.metaKey && (e.key === 'n' || e.key === 'N')) {
        e.preventDefault(); e.stopPropagation();
        commutaModoTitolo();
        return;
      }

      // Ctrl+Ins copia la selezione fatta dentro xterm: ttyd non ha nessuna
      // scorciatoia per copiare, si affida solo all'auto-copia su selezione
      // che il browser blocca quando non e' dentro un gesto utente.
      if (e.ctrlKey && !e.altKey && !e.metaKey && e.key === 'Insert') {
        var t = termDi(pannelloAttivo());
        var sel = t && t.getSelection();
        if (sel) {
          e.preventDefault(); e.stopPropagation();
          copiaTesto(sel, function (ok) {
            bottoneGela.textContent = ok ? '✓ copiato' : '✗ non riesco';
            setTimeout(function () { bottoneGela.textContent = '❄ Congela'; }, 1200);
          });
        }
        return;
      }

      if (e.ctrlKey || e.altKey || e.metaKey) {
        // Alt+0..9 salta al terminale con quell'id, qualunque sia la posizione.
        if (e.altKey && !e.ctrlKey && !e.metaKey && e.key >= '0' && e.key <= '9') {
          if (document.getElementById('term' + e.key + '-tab')) {
            e.preventDefault(); e.stopPropagation(); vaiPerId(e.key);
          }
        }
        // Ctrl+0..9 rinomina QUEL terminale: stesso id di Alt+cifra, cosi' la
        // cifra vuol dire sempre la stessa cosa e cambia solo il modificatore.
        //
        // Ctrl+T, che sarebbe stato il preferito per la rinomina, non e' una
        // scelta possibile: e' fra le scorciatoie che il browser tiene per se'
        // (apre una scheda nuova) e alla pagina non arriva nemmeno, quindi un
        // preventDefault non ci puo' niente. Le Ctrl+cifra alla pagina
        // arrivano -- salvo browser che se le prendano per saltare all'n-esima
        // scheda, ed e' la sola incognita rimasta. Nel terminale sono sequenze
        // di controllo che quasi nessuno usa (Ctrl+2 e' NUL, ^@, che serve in
        // emacs per set-mark). [RR]
        if (e.ctrlKey && !e.altKey && !e.metaKey && e.key >= '0' && e.key <= '9') {
          if (document.getElementById('term' + e.key + '-tab')) {
            e.preventDefault(); e.stopPropagation(); rinominaPerId(e.key);
          }
        }
        return;
      }
      if (!e.shiftKey) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); e.stopPropagation(); vaiA(indiceAttivo() + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); e.stopPropagation(); vaiA(indiceAttivo() - 1); }
    }

    // capture: il listener su document scatta PRIMA dell'handler di xterm sulla
    // textarea, quindi stopPropagation gli impedisce di vedere il tasto.
    function agganciaTasti(f) {
      try {
        var d = f.contentDocument;
        if (d && !d.__tastiAgganciati) {
          d.addEventListener('keydown', onTasto, true);
          d.__tastiAgganciati = true;
        }
      } catch (err) { /* niente da fare: resta attivo solo il listener del genitore */ }
    }

    // --- messaggi di ttyd ----------------------------------------------------
    // ttyd mostra i suoi avvisi ("Connection Closed", "Reconnecting...",
    // "Press <invio> to Reconnect", "Reconnected", il flash della copia) con un
    // <div> che l'OverlayAddon appende a .xterm: stile tutto in linea, nessuna
    // classe e nessun font-family, quindi eredita il monospace del terminale.
    // Il div sta DENTRO l'iframe, dove il CSS del genitore non arriva, e lo
    // stile in linea batterebbe comunque una regola senza !important: il font
    // si mette percio' sul nodo stesso, appena compare. [RR]
    var SANS = 'ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif';

    // Testi che dicono «la connessione e' caduta». "Reconnected" non ci casca
    // (e' l'avviso di ripristino) e nemmeno il flash della copia. [RR]
    var CADUTA = /connection closed|reconnecting|to reconnect/i;

    // L'overlay e' l'unico figlio di .xterm senza classe: quelli di xterm.js
    // (xterm-viewport, xterm-screen, xterm-helpers, ...) ce l'hanno tutti.
    function eOverlay(n) {
      return !!n && n.nodeType === 1 && n.tagName === 'DIV' && !n.className;
    }

    // Il nome del tab descrive cio' che gira nel terminale. Se la sessione
    // muore (exit dalla shell: `tmux new-session -A` al riaggancio ne crea una
    // NUOVA, non riattacca quella di prima) l'etichetta e' bugiarda, quindi
    // torna al default e la preferenza salvata viene cancellata. [RR]
    //
    // Questo azzeramento resta LOCALE, di proposito: non chiama sincronizza().
    // Col profilo condiviso, una websocket caduta -- un riavvio di nginx, il
    // telefono che perde campo -- cancellerebbe il nome su tutti i browser di
    // quella identita'. Al server salgono solo le rinomine volute. [RR]
    // QUANDO NON AZZERARE. "Connection Closed" non vuol dire sempre che la
    // sessione e' morta, e distinguere non e' un dettaglio: qui si cancella
    // una cosa scritta a mano dall'utente.
    //
    // Ricaricando la pagina le websocket cadono per forza, e ttyd fa in tempo
    // a scriverlo prima che la pagina se ne vada: il nome veniva azzerato
    // proprio durante l'F5, ed era per questo che non sopravviveva a un
    // ricaricamento -- il difetto e' stato trovato guardando il profilo sul
    // server, 73 byte con "nomi":{} scritti da PUT tutte andate a buon fine.
    //
    // Stessa cosa quando il telefono si blocca o si passa a un'altra
    // applicazione: al ritorno si vede la coda di QUELLA disconnessione, non
    // un exit, quindi per qualche secondo dopo che la pagina torna a schermo
    // non si azzera niente. [RR]
    var inUscita = false, tornata = 0, GRAZIA = 4000;
    window.addEventListener('pagehide', function () { inUscita = true; });
    window.addEventListener('beforeunload', function () { inUscita = true; });
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) tornata = Date.now();
    });

    function reimpostaNome(id) {
      if (inUscita || document.hidden || (tornata && Date.now() - tornata < GRAZIA)) return;
      var btn = document.getElementById('term' + id + '-tab');
      if (!btn) return;
      var span = btn.querySelector('.etichetta');
      if (!span || span.isContentEditable) return;   // rinomina in corso: non si tocca

      // Anche il nome automatico se ne va: la sessione dietro non c'e' piu',
      // quindi quel titolo racconta un'applicazione che non gira. Senza
      // questo il tab resterebbe "vim: relazione.txt" su un terminale morto.
      delete AUTO[id];

      // Senza tocca(): non e' una modifica VOLUTA, e non deve vincere sul
      // profilo del server. Se lo facesse, una sessione finita qui
      // cancellerebbe il nome su tutti i browser di questa identita' al
      // primo ricaricamento -- che e' esattamente cio' che questo
      // azzeramento, restando locale, vuole evitare.
      var n = leggi(CHIAVE_NOMI, {});
      delete n[id];
      scrivi(CHIAVE_NOMI, n);
      scriviEtichetta(id);
    }

    function agganciaOverlay(f, id) {
      var d;
      try { d = f.contentDocument; } catch (err) { return; }
      if (!d || d.__overlayAgganciato) return;

      // .xterm nasce quando ttyd apre il terminale, un momento dopo il load
      // dell'iframe: si attende con qualche tentativo invece di indovinare un
      // ritardo fisso.
      var tentativi = 0;
      (function attendi() {
        var el = null;
        try { el = d.querySelector('.xterm'); } catch (err) { return; }
        if (!el) { if (++tentativi < 100) setTimeout(attendi, 100); return; }
        d.__overlayAgganciato = true;

        function guarda(nodo) {
          if (!eOverlay(nodo)) return;
          nodo.style.fontFamily = SANS;
          if (CADUTA.test(nodo.textContent || '')) reimpostaNome(id);
        }

        // L'addon riusa sempre lo stesso nodo: lo appende, gli cambia il testo
        // e poi lo rimuove. Servono quindi sia childList sia characterData, e
        // il sottoalbero perche' il testo sta in un nodo figlio.
        var oss = new MutationObserver(function (mut) {
          for (var i = 0; i < mut.length; i++) {
            var m = mut[i], j;
            for (j = 0; j < m.addedNodes.length; j++) guarda(m.addedNodes[j]);
            var n = m.target;
            while (n && n !== el) {
              if (eOverlay(n)) { guarda(n); break; }
              n = n.parentNode;
            }
          }
        });
        oss.observe(el, { childList: true, subtree: true, characterData: true });

        // caso limite: overlay gia' a schermo prima dell'aggancio
        for (var k = 0; k < el.children.length; k++) guarda(el.children[k]);
      })();
    }

    document.addEventListener('keydown', onTasto, true);

    // Le classi dello schermo prima di creare il primo iframe: i tab si
    // stringono subito, e il terminale nasce con l'altezza definitiva invece
    // di fare un fit buono per mezzo secondo.
    classiSchermo();
    etichetteFont();
    mostraStoria();
    mostraModoTitolo();

    // Primo tab subito, gli altri a richiesta.
    caricaPannello(panes.querySelector('.tab-pane.active'));

    // La griglia dopo: se era accesa, e' qui che nascono gli altri iframe.
    avviaGriglia();

    // Il profilo per ultimo: i tab sono gia' a schermo con i nomi in cache, e
    // quando la risposta arriva si limita a sistemarli.
    caricaProfilo();
  </script>
</body>
</html>
