    var aiuto = null;

    function apriAiuto() {
      if (aiuto || inModifica) return;

      var fondo = document.createElement('div');
      fondo.className = 'aiuto';

      var carta = document.createElement('div');
      carta.className = 'aiuto-carta';

      var testata = document.createElement('div');
      testata.className = 'aiuto-testata';
      var titolo = document.createElement('strong');
      titolo.textContent = 'Scorciatoie';
      var bChiudi = document.createElement('button');
      bChiudi.type = 'button';
      bChiudi.className = 'bottone-gela';
      bChiudi.textContent = 'Chiudi (Esc)';
      // Il marchio piccolo, quello senza prompt: a 18 px il prompt sarebbe
      // una macchia.
      testata.appendChild(simbolo('marchio-piccolo', 'marchio'));
      testata.appendChild(titolo);
      testata.appendChild(bChiudi);

      var corpo = document.createElement('div');
      corpo.className = 'aiuto-corpo';
      AIUTO.forEach(function (sezione) {
        var h = document.createElement('h3');
        h.textContent = sezione.titolo;
        corpo.appendChild(h);

        var dl = document.createElement('dl');
        sezione.voci.forEach(function (v) {
          var dt = document.createElement('dt');
          if (v.tasti) {
            v.tasti.forEach(function (t, i) {
              if (i) {
                var sep = document.createElement('span');
                sep.className = 'sep';
                sep.textContent = '…';
                dt.appendChild(sep);
              }
              var k = document.createElement('kbd');
              k.textContent = t;
              dt.appendChild(k);
            });
          } else {
            var g = document.createElement('span');
            g.className = 'gesto';
            if (v.icona) conIcona(g, v.icona, v.gesto);
            else g.textContent = v.gesto;
            dt.appendChild(g);
          }
          var dd = document.createElement('dd');
          dd.textContent = v.che;
          dl.appendChild(dt);
          dl.appendChild(dd);
        });
        corpo.appendChild(dl);
      });

      var coda = document.createElement('p');
      coda.textContent = 'Nomi dei tab, quali terminali sono aperti e in che ordine, e la ' +
        'griglia, seguono l\'identita\' del certificato: li ritrovi cambiando browser.';
      corpo.appendChild(coda);

      // La licenza sta qui dentro e non in testata: e' una cosa che si legge
      // una volta, e questo e' l'unico posto della pagina dove c'e' spazio
      // per dirla per intero senza togliere niente ai terminali. [RR]
      var pieLicenza = document.createElement('p');
      pieLicenza.appendChild(document.createTextNode('Dato liberamente: MIT, con un augurio. '));
      var bLicenza = document.createElement('button');
      bLicenza.type = 'button';
      bLicenza.className = 'bottone-gela';
      bLicenza.textContent = 'Leggi la licenza';
      bLicenza.addEventListener('click', apriLicenza);
      pieLicenza.appendChild(bLicenza);
      corpo.appendChild(pieLicenza);

      carta.appendChild(testata);
      carta.appendChild(corpo);
      fondo.appendChild(carta);
      document.body.appendChild(fondo);

      bChiudi.addEventListener('click', chiudiAiuto);
      // Solo il fondo, non la carta: un click sul testo non deve chiudere
      // quello che si sta leggendo.
      fondo.addEventListener('pointerdown', function (e) { if (e.target === fondo) chiudiAiuto(); });

      aiuto = fondo;
      bottoneAiuto.classList.add('acceso');
      bottoneAiuto.setAttribute('aria-pressed', 'true');
      // Il fuoco esce dal terminale: cosi' Esc arriva qui e non al programma
      // che gira nel pannello.
      try { bChiudi.focus(); } catch (err) {}
    }

    function chiudiAiuto() {
      if (!aiuto) return;
      // Se la licenza sta aperta sopra, se ne va con lui: da sola resterebbe
      // per aria, con il fondo di una finestra che non c'e' piu'.
      chiudiLicenza();
      if (aiuto.parentNode) aiuto.parentNode.removeChild(aiuto);
      aiuto = null;
      bottoneAiuto.classList.remove('acceso');
      bottoneAiuto.setAttribute('aria-pressed', 'false');
      // il fuoco torna dove si stava scrivendo, o si scriverebbe nel vuoto
      if (!gelo && !inModifica) dagliIlFuoco(pannelloAttivo());
    }

    function commutaAiuto() { aiuto ? chiudiAiuto() : apriAiuto(); }

    // --- la licenza ----------------------------------------------------------
    // Stessa carta dell'aiuto -- classi .aiuto-*, cosi' c'e' un aspetto solo da
    // mantenere -- con .licenza che la mette sopra. Il testo e' quello che
    // install.sh ha scritto nel <pre> nascosto; se non c'e' (pagina generata da
    // un modello vecchio) il bottone dice dove trovarlo invece di aprire una
    // finestra vuota. [RR]
    var licenza = null;

    function testoLicenza() {
      var sorgente = document.getElementById('testo-licenza');
      // Il primo a capo e' quello che segue il tag di apertura, non fa parte
      // del testo; in coda taglia via lo spazio prima del tag di chiusura.
      var t = sorgente ? sorgente.textContent.replace(/^\n+/, '').replace(/\s+$/, '') : '';
      return t || 'Il testo della licenza non e\' in questa pagina: sta nel file LICENSE del progetto.';
    }

    function apriLicenza() {
      if (licenza) return;

      var fondo = document.createElement('div');
      fondo.className = 'aiuto licenza';

      var carta = document.createElement('div');
      carta.className = 'aiuto-carta';

      var testata = document.createElement('div');
      testata.className = 'aiuto-testata';
      var titolo = document.createElement('strong');
      titolo.textContent = 'Licenza';
      var bChiudi = document.createElement('button');
      bChiudi.type = 'button';
      bChiudi.className = 'bottone-gela';
      bChiudi.textContent = 'Chiudi (Esc)';
      testata.appendChild(titolo);
      testata.appendChild(bChiudi);

      var corpo = document.createElement('div');
      corpo.className = 'aiuto-corpo';
      var pre = document.createElement('pre');
      pre.textContent = testoLicenza();
      corpo.appendChild(pre);

      carta.appendChild(testata);
      carta.appendChild(corpo);
      fondo.appendChild(carta);
      document.body.appendChild(fondo);

      bChiudi.addEventListener('click', chiudiLicenza);
      fondo.addEventListener('pointerdown', function (e) { if (e.target === fondo) chiudiLicenza(); });

      licenza = fondo;
      try { bChiudi.focus(); } catch (err) {}
    }

    function chiudiLicenza() {
      if (!licenza) return;
      if (licenza.parentNode) licenza.parentNode.removeChild(licenza);
      licenza = null;
      // Dietro c'e' ancora l'aiuto: il fuoco torna li', o Esc non avrebbe piu'
      // nessuno a cui parlare. Se non c'e' piu' -- ci si arriva da
      // chiudiAiuto() -- ci pensa lui a rimandarlo nel terminale.
      var b = aiuto && aiuto.querySelector('.aiuto-testata button');
      if (b) { try { b.focus(); } catch (err) {} }
    }

    nomina(bottoneAiuto, 'Aiuto · Ctrl+H', 'elenco delle scorciatoie');
    bottoneAiuto.setAttribute('aria-pressed', 'false');
    bottoneAiuto.addEventListener('click', commutaAiuto);

    // --- tastiera ------------------------------------------------------------
    function onTasto(e) {
      if (inModifica) return;

      // La licenza sta sopra l'aiuto e i tasti sono suoi finche' e' aperta:
      // se no Ctrl+H chiuderebbe l'aiuto lasciando lei a mezz'aria.
      if (licenza) {
        if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); chiudiLicenza(); }
        return;
      }

      // Ctrl+H apre e chiude l'elenco delle scorciatoie.
      //
      // Va detto che nel terminale Ctrl+H e' ^H, cioe' backspace per readline
      // e per vi in inserimento: intercettandolo qui, chi cancella cosi' non
      // cancella piu'. E' la scorciatoia chiesta, ed e' l'unica di questa
      // pagina che non passa da Ctrl+Alt: se dovesse dare fastidio, cambiarla
      // e' una riga sola (per esempio F1, o Ctrl+Alt+H come le altre). [RR]
      if (e.ctrlKey && !e.altKey && !e.metaKey && (e.key === 'h' || e.key === 'H')) {
        e.preventDefault(); e.stopPropagation();
        commutaAiuto();
        return;
      }
      // Con l'elenco aperto i tasti restano qui: Esc chiude, il resto non
      // finisce nel terminale che sta dietro.
      if (aiuto) {
        if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); chiudiAiuto(); }
        return;
      }

      // Ctrl+Alt+C congela / riprende. Con il pannello congelato, Esc riprende.
      if (e.ctrlKey && e.altKey && !e.metaKey && (e.key === 'c' || e.key === 'C')) {
        e.preventDefault(); e.stopPropagation();
        gelo ? scongela() : congela();
        return;
      }
      if (gelo) {
        if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); scongela(); }
        return;   // congelati non si naviga: il tab resta quello che stai copiando
      }

      // Ctrl+Alt+G cicla la griglia. Dopo il blocco del congelamento: a
      // pannello congelato si sta copiando, e cambiare il numero di celle
      // sposterebbe sotto il mouse proprio il testo che si sta selezionando.
      if (e.ctrlKey && e.altKey && !e.metaKey && (e.key === 'g' || e.key === 'G')) {
        e.preventDefault(); e.stopPropagation();
        commutaGriglia();
        return;
      }

      // Ctrl+Alt+N cicla il nome dei tab: titolo dell'applicazione, comando in
      // esecuzione, solo i nomi scritti a mano.
      if (e.ctrlKey && e.altKey && !e.metaKey && (e.key === 'n' || e.key === 'N')) {
        e.preventDefault(); e.stopPropagation();
        commutaModoTitolo();
        return;
      }

      // Ctrl+Alt+W chiude il tab che sta davanti: il terminale torna fra i
      // liberi e la sua sessione tmux continua a girare. E' la via da tastiera
      // al \u2715 sul tab; Ctrl+W non si puo' usare, il browser se lo prende per
      // chiudere la scheda e alla pagina non arriva.
      if (e.ctrlKey && e.altKey && !e.metaKey && (e.key === 'w' || e.key === 'W')) {
        e.preventDefault(); e.stopPropagation();
        var davanti = pannelloAttivo();
        if (davanti) chiudiTerminale(idDi(davanti));
        return;
      }

      // Ctrl+Ins copia la selezione fatta dentro xterm: ttyd non ha nessuna
      // scorciatoia per copiare, si affida solo all'auto-copia su selezione
      // che il browser blocca quando non e' dentro un gesto utente.
      if (e.ctrlKey && !e.altKey && !e.metaKey && e.key === 'Insert') {
        var t = termDi(pannelloAttivo());
        var sel = t && t.getSelection();
        if (sel) {
          e.preventDefault(); e.stopPropagation();
          copiaTesto(sel, avvisaCopia);
        }
        return;
      }

      if (e.ctrlKey || e.altKey || e.metaKey) {
        // Alt+1..9 va al tab in quella posizione, Alt+0 all'ultimo.
        if (e.altKey && !e.ctrlKey && !e.metaKey && e.key >= '0' && e.key <= '9') {
          var vai = tabInPosizione(e.key);
          if (vai) { e.preventDefault(); e.stopPropagation(); vaiPerId(vai.dataset.id); }
        }
        // Ctrl+1..9 rinomina il tab in quella posizione, Ctrl+0 l'ultimo:
        // stessa cifra di Alt, cosi' vuol dire sempre lo stesso tab e cambia
        // solo il modificatore.
        //
        // Ctrl+T, che sarebbe stato il preferito per la rinomina, non e' una
        // scelta possibile: e' fra le scorciatoie che il browser tiene per se'
        // (apre una scheda nuova) e alla pagina non arriva nemmeno, quindi un
        // preventDefault non ci puo' niente. Le Ctrl+cifra alla pagina
        // arrivano -- salvo browser che se le prendano per saltare all'n-esima
        // scheda, ed e' la sola incognita rimasta. Nel terminale sono sequenze
        // di controllo che quasi nessuno usa (Ctrl+2 e' NUL, ^@, che serve in
        // emacs per set-mark). [RR]
        if (e.ctrlKey && !e.altKey && !e.metaKey && e.key >= '0' && e.key <= '9') {
          var rin = tabInPosizione(e.key);
          if (rin) { e.preventDefault(); e.stopPropagation(); rinomina(rin); }
        }
        return;
      }
      if (!e.shiftKey) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); e.stopPropagation(); vaiA(indiceAttivo() + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); e.stopPropagation(); vaiA(indiceAttivo() - 1); }
    }

    // capture: il listener su document scatta PRIMA dell'handler di xterm sulla
    // textarea, quindi stopPropagation gli impedisce di vedere il tasto.
    function agganciaTasti(f) {
      try {
        var d = f.contentDocument;
        if (d && !d.__tastiAgganciati) {
          d.addEventListener('keydown', onTasto, true);
          d.__tastiAgganciati = true;
        }
      } catch (err) { /* niente da fare: resta attivo solo il listener del genitore */ }
    }

    // --- messaggi di ttyd ----------------------------------------------------
    // ttyd mostra i suoi avvisi ("Connection Closed", "Reconnecting...",
    // "Press <invio> to Reconnect", "Reconnected", il flash della copia) con un
    // <div> che l'OverlayAddon appende a .xterm: stile tutto in linea, nessuna
    // classe e nessun font-family, quindi eredita il monospace del terminale.
    // Il div sta DENTRO l'iframe, dove il CSS del genitore non arriva, e lo
    // stile in linea batterebbe comunque una regola senza !important: il font
    // si mette percio' sul nodo stesso, appena compare. [RR]
    var SANS = 'ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif';

    // Testi che dicono «la connessione e' caduta». "Reconnected" non ci casca
    // (e' l'avviso di ripristino) e nemmeno il flash della copia. [RR]
    var CADUTA = /connection closed|reconnecting|to reconnect/i;

    // L'overlay e' l'unico figlio di .xterm senza classe: quelli di xterm.js
    // (xterm-viewport, xterm-screen, xterm-helpers, ...) ce l'hanno tutti.
    function eOverlay(n) {
      return !!n && n.nodeType === 1 && n.tagName === 'DIV' && !n.className;
    }

    // --- quando la shell muore ----------------------------------------------
    // `exit` o Ctrl-D chiudono la shell, la sessione tmux finisce e dietro a
    // quel tab non c'e' piu' niente: il tab si chiude e il terminale torna fra
    // i liberi. Il nome se ne va con lui -- descriveva cio' che girava, e al
    // riaggancio `tmux new-session -A` crea una sessione NUOVA, non riattacca
    // quella di prima.
    //
    // COME SI SA CHE E' MORTA, e non che e' solo caduta la linea. ttyd scrive
    // "Connection Closed" in tutti e due i casi, e distinguere non e' un
    // dettaglio: qui si chiude un tab e si cancella un nome scritto a mano.
    // Si guarda percio' cio' che il CLIENT tmux lascia scritto sullo schermo
    // prima di uscire: quando la sessione finisce, esce dallo schermo
    // alternativo, pulisce e stampa
    //
    //     [exited]
    //
    // Verificato su tmux 3.2a registrando il pty di un client vero, che e' lo
    // stesso modo con cui si e' trovato l'indicatore della copy-mode. Una
    // linea caduta invece non lo stampa: dall'altra parte il processo viene
    // ucciso, non esce, e lo schermo resta all'ultimo fotogramma. Quindi il
    // tab e il nome restano dove sono e ttyd si riaggancia da se'.
    //
    // Questo rende inutili le due guardie che c'erano prima -- non azzerare
    // mentre la pagina non e' a schermo, e per qualche secondo dopo che ci e'
    // tornata: servivano perche' l'unico indizio era "Connection Closed", che
    // al ritorno da un telefono bloccato e' la coda della disconnessione di
    // sistema e non un exit. Adesso quel caso lo esclude il controllo stesso,
    // che li' non trova nessun [exited]. Resta `inUscita`, e non per il nome:
    // durante un F5 le websocket cadono per forza, e chiudere dei tab mentre
    // la pagina se ne va vorrebbe dire salvare un elenco di aperti mutilato --
    // si ricaricherebbe con meta' terminali finiti nel contenitore. [RR]
    var inUscita = false;
    window.addEventListener('pagehide', function () { inUscita = true; });
    window.addEventListener('beforeunload', function () { inUscita = true; });

    var USCITO = /^\[exited\]$/;

    // Il [exited] sta sulla schermata visibile, non nello scrollback: dopo il
    // clear e' la prima riga. Si guardano tutte le righe a schermo perche' il
    // cursore, al momento dell'uscita, non e' detto che fosse in cima.
    function sessioneFinita(term) {
      try {
        var buf = term.buffer.active;
        // Con un client tmux attaccato lo schermo e' quello alternato: tutto
        // cio' che scorre nel terminale sta li'. Il [exited] lo stampa il
        // client DOPO esserne uscito, cioe' sullo schermo normale. Chiedere il
        // buffer normale costa niente e toglie di mezzo i falsi allarmi -- un
        // `cat` di un log che contiene [exited] chiuderebbe il tab. [RR]
        if (buf.type !== 'normal') return false;
        for (var i = 0; i < term.rows; i++) {
          var linea = buf.getLine(buf.viewportY + i);
          if (linea && USCITO.test(linea.translateToString(true).trim())) return true;
        }
        return false;
      } catch (err) { return false; }
    }

    // L'avviso di ttyd arriva quando la websocket si chiude, e le ultime righe
    // possono essere ancora in coda dentro xterm.js, che scrive in modo
    // asincrono: si guarda piu' volte per un paio di secondi invece di
    // indovinare un ritardo. Un controllo per terminale alla volta, o ogni
    // riscrittura dell'avviso ("Reconnecting...", "Press <invio> to
    // Reconnect") ne farebbe partire un altro.
    var controlli = {};

    function controllaMorte(id, giri) {
      if (inUscita || !tabDi(id)) { delete controlli[id]; return; }
      var term = termDi(pannelloDi(id));
      if (term && sessioneFinita(term)) {
        delete controlli[id];
        chiudiTerminale(id, true);
        return;
      }
      if (giri > 0) setTimeout(function () { controllaMorte(id, giri - 1); }, 150);
      else delete controlli[id];
    }

    // --- prendere il [exited] al volo ---------------------------------------
    // Cercarlo quando arriva l'avviso di ttyd e' tardi: a schermo ci resta
    // pochissimo. Alla chiusura della websocket il client di ttyd si riaggancia
    // DA SOLO -- il codice di chiusura e' 1006, non 1000, e li' scatta il suo
    // doReconnect -- e appena riaperto fa `terminal.reset()`; subito dopo il
    // nuovo client tmux entra nello schermo alternato. Da quel momento il
    // [exited] non c'e' piu' da nessuna parte, e chi lo cerca trova soltanto
    // una sessione nuova di zecca.
    //
    // Misurato sulla websocket di ttyd: il frame con [exited] arriva 0,4 ms
    // prima della chiusura. La ricerca lanciata dall'avviso parte percio'
    // mentre xterm ha ancora quel pezzo in coda (scrive in modo asincrono), e i
    // tentativi successivi corrono contro il riaggancio, che e' un giro di
    // rete: chi arriva primo cambia di volta in volta. E' questa la ragione per
    // cui con Ctrl-D il tab restava aperto e con `exit` si chiudeva, pur
    // essendo i byte in arrivo gli stessi -- verificato registrando le due
    // uscite sulla websocket: identiche fino all'ultimo byte.
    //
    // Agganciandosi alla scrittura di xterm il controllo avviene nell'istante
    // in cui il [exited] entra nel buffer, prima che qualcuno possa cancellarlo,
    // e la gara non si corre piu'. Il controllo sull'avviso resta come rete di
    // sicurezza per gli xterm.js senza questi eventi. [RR]
    function agganciaMorte(pane, id, quanti) {
      var term = termDi(pane);
      if (!term) {
        if (quanti > 0) setTimeout(function () { agganciaMorte(pane, id, quanti - 1); }, 100);
        return;
      }
      // Il riaggancio riusa lo stesso oggetto Terminal: l'ascoltatore si mette
      // una volta sola e vale anche per le sessioni che verranno dopo.
      if (term.__morteAgganciata) return;
      term.__morteAgganciata = true;

      function guarda() {
        if (inUscita || !tabDi(id) || !sessioneFinita(term)) return;
        // Qui si e' dentro l'analisi di xterm: chiudere adesso vorrebbe dire
        // togliere l'iframe da sotto al codice che sta girando.
        setTimeout(function () {
          if (!inUscita && tabDi(id)) chiudiTerminale(id, true);
        }, 0);
      }

      // onWriteParsed scatta appena il pezzo ricevuto e' finito nel buffer.
      // onLineFeed e' il ripiego per gli xterm.js piu' vecchi: il [exited]
      // arriva col suo a capo, quindi di li' passa comunque.
      if (term.onWriteParsed) term.onWriteParsed(guarda);
      else if (term.onLineFeed) term.onLineFeed(guarda);
    }

    // Il nome scritto a mano e quello automatico se ne vanno insieme: il primo
    // descriveva un lavoro che non c'e' piu', il secondo un'applicazione che
    // non gira piu'. Senza questo un terminale libero resterebbe in fila col
    // nome "vim: relazione.txt".
    //
    // Sale anche al server, ed e' un cambio rispetto a prima, quando restava
    // locale: allora l'indizio era la sola "Connection Closed", e un riavvio
    // di nginx avrebbe cancellato i nomi su tutti i browser di quella
    // identita'. Adesso si arriva qui solo con un [exited] vero, e una
    // sessione finita e' finita per tutti i dispositivi, non solo per questo.
    function dimenticaNome(id) {
      delete AUTO[id];
      var n = leggi(CHIAVE_NOMI, {});
      delete n[id];
      scrivi(CHIAVE_NOMI, n);
      scriviEtichetta(id);
    }

    function agganciaOverlay(f, id) {
      var d;
      try { d = f.contentDocument; } catch (err) { return; }
      if (!d || d.__overlayAgganciato) return;

      // .xterm nasce quando ttyd apre il terminale, un momento dopo il load
      // dell'iframe: si attende con qualche tentativo invece di indovinare un
      // ritardo fisso.
      var tentativi = 0;
      (function attendi() {
        var el = null;
        try { el = d.querySelector('.xterm'); } catch (err) { return; }
        if (!el) { if (++tentativi < 100) setTimeout(attendi, 100); return; }
        d.__overlayAgganciato = true;
        statoTab(id, 'connesso');

        function guarda(nodo) {
          if (!eOverlay(nodo)) return;
          nodo.style.fontFamily = SANS;
          var testo = nodo.textContent || '';
          // La spia prima dei controlli sulla caduta: deve seguire anche
          // "Reconnected", che caduta non e'. L'ordine conta: "Press <invio>
          // to Reconnect" e' lo scollegato che aspetta un tasto, gli altri due
          // sono il riaggancio che ttyd tenta da solo.
          if (/reconnected/i.test(testo)) statoTab(id, 'connesso');
          else if (/to reconnect/i.test(testo)) statoTab(id, 'scollegato');
          else if (/connection closed|reconnecting/i.test(testo)) statoTab(id, 'riconnessione');
          if (!CADUTA.test(testo)) return;
          if (inUscita || controlli[id]) return;
          controlli[id] = 1;
          controllaMorte(id, 20);
        }

        // L'addon riusa sempre lo stesso nodo: lo appende, gli cambia il testo
        // e poi lo rimuove. Servono quindi sia childList sia characterData, e
        // il sottoalbero perche' il testo sta in un nodo figlio.
        var oss = new MutationObserver(function (mut) {
          for (var i = 0; i < mut.length; i++) {
            var m = mut[i], j;
            for (j = 0; j < m.addedNodes.length; j++) guarda(m.addedNodes[j]);
            var n = m.target;
            while (n && n !== el) {
              if (eOverlay(n)) { guarda(n); break; }
              n = n.parentNode;
            }
          }
        });
        oss.observe(el, { childList: true, subtree: true, characterData: true });

        // caso limite: overlay gia' a schermo prima dell'aggancio
        for (var k = 0; k < el.children.length; k++) guarda(el.children[k]);
      })();
    }

    document.addEventListener('keydown', onTasto, true);

    // Le classi dello schermo prima di creare il primo iframe: i tab si
    // stringono subito, e il terminale nasce con l'altezza definitiva invece
    // di fare un fit buono per mezzo secondo.
    classiSchermo();
    etichetteFont();
    mostraStoria();
    mostraModoTitolo();
    mostraGela();

    // La fila dei liberi: e' anche lei che decide il layout, perche' senza
    // nessun tab aperto si prende tutto lo spazio dei pannelli.
    disegnaScatola();

    // Primo tab subito, gli altri a richiesta. Se in testata non c'e' niente
    // -- primo accesso, o tutti i tab chiusi -- non c'e' nessun pannello da
    // caricare e non si apre nessuna websocket: si aspetta un click.
    caricaPannello(panes.querySelector('.tab-pane.active'));

    // La griglia dopo: se era accesa, e' qui che nascono gli altri iframe.
    avviaGriglia();

    // Il profilo per ultimo: i tab sono gia' a schermo con i nomi in cache, e
    // quando la risposta arriva si limita a sistemarli.
    caricaProfilo();
  </script>
</body>
</html>
