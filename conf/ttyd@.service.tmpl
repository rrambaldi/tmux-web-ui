# Un'istanza ttyd per porta: ttyd@8700, ttyd@8701, ... Il numero (%i) e' sia la
# porta sia il nome della sessione tmux, cosi' non serve una seconda tabella per
# tenerli allineati. [RR]
[Unit]
Description=ttyd terminal instance on port %i
After=network.target

[Service]
# -W abilita la scrittura sul TTY: dalla 1.7.0 ttyd e' read-only per default e
#    senza questo si vede il terminale ma non si puo' digitare.
# -i 127.0.0.1 lega ttyd alla loopback: l'unico ingresso e' nginx, che fa mTLS.
#    Senza questo ttyd sarebbe esposto in chiaro e senza autenticazione.
# tmux new-session -A riattacca la sessione se esiste, altrimenti la crea: e'
#    quello che rende il terminale persistente fra chiusure del browser. Con
#    "exit" dalla shell la sessione muore e al riaggancio se ne crea una nuova.
ExecStart=/usr/bin/ttyd -W -p %i -i 127.0.0.1 tmux new-session -A -s term-%i bash -l
Restart=always
RestartSec=2

# KillMode=process, e non il default control-group, per una ragione che si
# scopre nel modo peggiore. Il server tmux non nasce come processo a se': lo
# avvia il PRIMO `tmux new-session` che parte, quindi finisce nel cgroup di
# quella unit ttyd. Col default, fermare quella unit uccide tutto il suo
# cgroup -- server tmux compreso -- e con esso TUTTE le sessioni, non solo la
# sua: `install.sh`, che fa restart su ogni porta, azzerava il lavoro aperto
# in tutti i terminali. Con 'process' si ferma solo ttyd; il client e il
# server tmux restano, e al riaggancio `new-session -A` ritrova la sessione.
# E' quello che il progetto ha sempre dichiarato di fare. [RR]
KillMode=process
User=@UTENTE@
Group=@GRUPPO@
WorkingDirectory=~

[Install]
WantedBy=multi-user.target
